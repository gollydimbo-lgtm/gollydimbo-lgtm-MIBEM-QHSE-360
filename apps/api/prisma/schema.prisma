  reference String?
  auditDate DateTime
  auditorId String?
  status String @default("PLANNED")
  score Float?
  findings Json?
  processusId String?
  fournisseurId String?
  auditor User? @relation(fields:[auditorId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  auditFindings AuditFinding[]
}

// Constat d'audit structuré — remplace le champ "findings" en texte
// libre jamais exploité. Un constat critique peut générer automatiquement
// une non-conformité et une action, exactement comme un point de
// contrôle critique le fait déjà dans le moteur de contrôle universel.
model AuditFinding {
  id String @id @default(cuid())
  auditId String
  description String
  classification String?
  critical Boolean @default(false)
  status String @default("OPEN")
  nonConformityId String?
  createdAt DateTime @default(now())
  audit QhseAudit @relation(fields:[auditId], references:[id], onDelete:Cascade)
  nonConformity NonConformity? @relation(fields:[nonConformityId], references:[id], onDelete:SetNull)
}

model EnvironmentRecord {
  id String @id @default(cuid())
  code String @unique
  type String
  value Float?
  unit String?
  site String?
  recordedAt DateTime @default(now())
  notes String?
}

model Training {
  id String @id @default(cuid())
  code String @unique
  title String
  trainer String?
  scheduledAt DateTime
  durationHours Float?
  status String @default("PLANNED")
  participants Json?
  expiryAt DateTime?
  processusId String?
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
}

model Equipment {
  id String @id @default(cuid())
  code String @unique
  name String
  category String?
  location String?
  status String @default("ACTIVE")
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  notes String?
}

model SafetyTalk {
  id String @id @default(cuid())
  weekStart DateTime
  weekEnd DateTime
  title String
  summary String
  status SafetyTalkStatus @default(DRAFT)
  generatedAt DateTime @default(now())
