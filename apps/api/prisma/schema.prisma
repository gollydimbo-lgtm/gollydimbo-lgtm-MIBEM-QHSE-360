  pilier String?
  cible Float
  actuel Float @default(0)
  unite String?
  echeance DateTime?
  processusId String?
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
