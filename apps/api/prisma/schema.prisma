generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleName {
  ADMINISTRATEUR
  RESPONSABLE_QHSE
  ASSISTANT_QHSE
  CONTROLEUR_QUALITE
  CHEF_PRODUCTION
  OPERATEUR
  AUDITEUR
  CONSULTATION
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum EpiFrequency {
  DAILY
  ANNUAL
}

enum EpiMovementType {
  RECEIPT
  DAILY_DISTRIBUTION
  ANNUAL_DISTRIBUTION
  REPLACEMENT
  LOSS
  DAMAGE
  ADJUSTMENT
  RETURN
  REFORM
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum SafetyTalkStatus {
  DRAFT
  APPROVED
  DELIVERED
}

enum QualityControlStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  COMPLIANT
  NON_COMPLIANT
  CANCELLED
}

enum ControlValueType {
  BOOLEAN
  NUMERIC
  TEXT
  CHOICE
  PHOTO
  DATE
  TIME
  PERCENTAGE
  SIGNATURE
  RATING
}

enum SignatureType {
  CONTROLLER
  RESPONSIBLE
  VALIDATOR
}

enum AttachmentOwnerType {
  QUALITY_CONTROL
  NON_CONFORMITY
  ACTION
  SAFETY_EVENT
  RISK
  AUDIT
  EPI
}

enum QualityShift {
  MORNING
  AFTERNOON
  NIGHT
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  status UserStatus @default(ACTIVE)
  employeeId String? @unique
  roles UserRole[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  attachments Attachment[]
  documentsCreated Document[] @relation("DocumentCreator")
  epiMovements EpiMovement[]
  safetyTalks SafetyTalk[]
  actionsResponsible Action[]
  qualityControls QualityControl[]
  qualitySignatures QualityControlSignature[]
  controlResults ControlResult[]
  audits QhseAudit[]
  refreshTokens RefreshToken[]
  epcResponsible Epc[]
  epcInspections EpcInspection[]
  epiInspections EpiInspection[]
  epiAssignmentsResponsible EpiAssignment[]
  epcMaintenancesPerformed EpcMaintenance[]
  controlSchedulesAssigned ControlSchedule[]
}

model Role {
  id String @id @default(cuid())
  name RoleName @unique
  permissions RolePermission[]
  users UserRole[]
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  role Role @relation(fields:[roleId], references:[id], onDelete: Cascade)
  @@id([userId,roleId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields:[roleId], references:[id], onDelete: Cascade)
  permission Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade)
  @@id([roleId,permissionId])
}

model RefreshToken {
  id String @id @default(cuid())
  tokenHash String
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  module String
  entityId String?
  oldValue Json?
  newValue Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId], references:[id], onDelete: SetNull)
  @@index([module,entityId])
  @@index([createdAt])
}

model Attachment {
  id String @id @default(cuid())
  originalName String
  storagePath String
  mimeType String
  size Int
  sha256 String?
  uploadedById String?
  documentId String?
  createdAt DateTime @default(now())
  uploadedBy User? @relation(fields:[uploadedById], references:[id], onDelete:SetNull)
  document Document? @relation(fields:[documentId], references:[id], onDelete: Cascade)
  links AttachmentLink[]
  qualityControlLinks QualityControlAttachment[]
  @@index([documentId])
}

// Liaison générique attachment <-> entité métier (accident, NC, risque, audit, EPI...).
// Complète QualityControlAttachment qui reste dédiée au contrôle qualité pour compatibilité.
model AttachmentLink {
  id String @id @default(cuid())
  ownerType AttachmentOwnerType
  ownerId String
  attachmentId String
  createdAt DateTime @default(now())
  attachment Attachment @relation(fields:[attachmentId], references:[id], onDelete:Cascade)
  @@unique([ownerType,ownerId,attachmentId])
  @@index([ownerType,ownerId])
}

// Classification transverse en 5 groupes du référentiel documentaire QHSE
// (Stratégie/Contexte, Risques/Sécurité/Conformité, Supports/Maîtrise
// documentaire, Opérations/Maîtrise terrain, Évaluation/Contrôle/Amélioration).
// Vient EN PLUS du champ "category" existant, sans le remplacer : purement
// additif, aucune donnée existante n'est modifiée par ce changement de schéma.
enum DocumentGroup {
  STRATEGIE_CONTEXTE
  RISQUES_SECURITE_CONFORMITE
  SUPPORTS_MAITRISE_DOCUMENTAIRE
  OPERATIONS_MAITRISE_TERRAIN
  EVALUATION_CONTROLE_AMELIORATION
}

model Document {
  id String @id @default(cuid())
  code String @unique
  title String
  category String
  documentGroup DocumentGroup?
  status DocumentStatus @default(DRAFT)
  currentVersion Int @default(1)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User? @relation("DocumentCreator", fields:[createdById], references:[id], onDelete:SetNull)
  versions DocumentVersion[]
  attachments Attachment[]
}

model DocumentVersion {
  id String @id @default(cuid())
  documentId String
  version Int
  fileName String
  storagePath String
  checksum String?
  status DocumentStatus @default(DRAFT)
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)
  @@unique([documentId,version])
}

// Catégories EPI — table gérable par l'administrateur, jamais une liste
// figée en dur (le cahier des charges l'exige explicitement).
model EpiCategory {
  id String @id @default(cuid())
  name String @unique
  epis Epi[]
}

model Epi {
  id String @id @default(cuid())
  code String @unique
  name String
  frequency EpiFrequency
  unit String @default("piece")
  annualValidityDays Int?
  minStock Int @default(0)
  active Boolean @default(true)
  movements EpiMovement[]
  assignments EpiAssignment[]
  categoryId String?
  category EpiCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  reference String?
  subcategory String?
  description String?
  manufacturer String?
  model String?
  size String?
  color String?
  material String?
  standard String?
  // Mode de durée d'utilisation — jamais une valeur universelle : configurable
  // équipement par équipement, selon le fabricant, la réglementation,
  // l'analyse des risques, l'usage et l'état constaté en inspection.
  durationMode String?
  durationValueDays Int?
  disposable Boolean @default(false)
  shared Boolean @default(false)
  maxStock Int?
  location String?
  status String @default("ACTIVE")
  inspections EpiInspection[]
  jobRiskProtections JobRiskProtection[]
  nonConformities NonConformity[]
  qualityControls QualityControl[]
}

model Employee {
  id String @id @default(cuid())
  matricule String @unique
  firstName String
  lastName String
  department String?
  position String?
  active Boolean @default(true)
  epiAssignments EpiAssignment[]
  epiMovements EpiMovement[]
  epiInspections EpiInspection[]
  qualityControls QualityControl[]
}

model EpiAssignment {
  id String @id @default(cuid())
  code String @unique
  employeeId String
  epiId String
  quantity Int
  size String?
  distributedAt DateTime
  renewalAt DateTime?
  expectedDurationDays Int?
  condition String?
  reason String?
  status String @default("ACTIVE")
  responsibleId String?
  // Signatures électroniques — stockées en base64 (image PNG dessinée),
  // jamais un simple champ texte "signé par" : preuve réelle de la remise.
  employeeSignature String?
  responsibleSignature String?
  employee Employee @relation(fields:[employeeId], references:[id], onDelete:Cascade)
  epi Epi @relation(fields:[epiId], references:[id], onDelete:Restrict)
  responsible User? @relation(fields:[responsibleId], references:[id], onDelete:SetNull)
  @@index([employeeId,epiId])
}

model EpiMovement {
  id String @id @default(cuid())
  epiId String
  type EpiMovementType
  quantity Int
  employeeId String?
  distributionDate DateTime @default(now())
  userId String?
  note String?
  epi Epi @relation(fields:[epiId], references:[id], onDelete:Restrict)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([epiId,distributionDate])
}

// Checklist d'inspection EPI (casque, harnais, chaussures...) — résultat
// standardisé, jamais une simple case cochée/décochée.
model EpiInspection {
  id String @id @default(cuid())
  epiId String
  epi Epi @relation(fields:[epiId], references:[id], onDelete:Cascade)
  employeeId String?
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  inspectedAt DateTime @default(now())
  result String
  observations String?
  inspectedById String?
  inspectedBy User? @relation(fields:[inspectedById], references:[id], onDelete:SetNull)
}

// Catégories EPC — table gérable par l'administrateur, comme pour les EPI.
model EpcCategory {
  id String @id @default(cuid())
  name String @unique
  epcs Epc[]
}

model Epc {
  id String @id @default(cuid())
  code String @unique
  name String
  categoryId String?
  category EpcCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  location String?
  zone String?
  description String?
  manufacturer String?
  model String?
  reference String?
  installedAt DateTime?
  responsibleId String?
  responsible User? @relation(fields:[responsibleId], references:[id], onDelete:SetNull)
  condition String?
  status String @default("ACTIVE")
  inspectionFrequencyDays Int?
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  notes String?
  inspections EpcInspection[]
  jobRiskProtections JobRiskProtection[]
  nonConformities NonConformity[]
  maintenances EpcMaintenance[]
  qualityControls QualityControl[]
}

model EpcInspection {
  id String @id @default(cuid())
  epcId String
  epc Epc @relation(fields:[epcId], references:[id], onDelete:Cascade)
  inspectedAt DateTime @default(now())
  result String
  observations String?
  inspectedById String?
  inspectedBy User? @relation(fields:[inspectedById], references:[id], onDelete:SetNull)
}

// Historique de maintenance EPC — préventive ou corrective, avec la
// prochaine échéance pour pouvoir la suivre dans le temps.
model EpcMaintenance {
  id String @id @default(cuid())
  epcId String
  epc Epc @relation(fields:[epcId], references:[id], onDelete:Cascade)
  date DateTime @default(now())
  type String
  description String?
  cost Float?
  performedById String?
  performedBy User? @relation(fields:[performedById], references:[id], onDelete:SetNull)
  nextMaintenanceAt DateTime?
  status String @default("DONE")
}

// La matrice Poste → Activité → Danger → Risque → Mesure de prévention →
// EPC/EPI → Fréquence d'utilisation → Critère de contrôle, exigée dans le
// cahier des charges. Chaque ligne relie un poste à un équipement — jamais
// une durée ou une exigence figée en dur.
model JobRiskProtection {
  id String @id @default(cuid())
  code String @unique
  jobTitle String
  activity String?
  hazard String
  riskDescription String?
  preventionMeasure String?
  epiId String?
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  epcId String?
  epc Epc? @relation(fields:[epcId], references:[id], onDelete:SetNull)
  usageFrequency String?
  controlCriteria String?
  createdAt DateTime @default(now())
}

model DailyHeadcount {
  id String @id @default(cuid())
  date DateTime @unique
  headcount Int
  source String?
  createdAt DateTime @default(now())
}

model SyncItem {
  id String @id @default(cuid())
  clientLocalId String @unique
  entity String
  entityId String?
  operation String
  payload Json
  status SyncStatus @default(PENDING)
  error String?
  createdAt DateTime @default(now())
  syncedAt DateTime?
}

model SafetyEvent {
  id String @id @default(cuid())
  type String
  title String
  description String?
  occurredAt DateTime
  severity Int @default(1)
  withLostTime Boolean @default(false)
  lostDays Int?
  createdAt DateTime @default(now())
}

// Heures travaillées par période, nécessaires au calcul du Taux de Fréquence
// (TF) et du Taux de Gravité (TG) des accidents du travail :
//   TF = (accidents avec arrêt × 1 000 000) / heures travaillées
//   TG = (journées perdues × 1 000) / heures travaillées
model WorkedHours {
  id String @id @default(cuid())
  code String @unique
  periodStart DateTime
  periodEnd DateTime
  hours Float
  site String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NonConformity {
  id String @id @default(cuid())
  code String @unique
  title String
  description String?
  severity Int @default(1)
  status String @default("OPEN")
  source String?
  // Classification configurable (observation, écart mineur, NC mineure/
  // majeure/critique, danger immédiat, anomalie...) — texte libre plutôt
  // qu'un enum figé, pour rester personnalisable sans toucher au code.
  classification String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  qualityControlId String?
  epiId String?
  epcId String?
  actions Action[]
  qualityControl QualityControl? @relation(fields:[qualityControlId], references:[id], onDelete:SetNull)
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  epc Epc? @relation(fields:[epcId], references:[id], onDelete:SetNull)
  @@index([status,occurredAt])
}

model Action {
  id String @id @default(cuid())
  code String @unique
  title String
  description String?
  status String @default("OPEN")
  priority Int @default(2)
  dueDate DateTime?
  completedAt DateTime?
  responsibleId String?
  nonConformityId String?
  responsible User? @relation(fields:[responsibleId], references:[id], onDelete:SetNull)
  nonConformity NonConformity? @relation(fields:[nonConformityId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,dueDate])
}

model Site {
  id String @id @default(cuid())
  code String @unique
  name String
  location String?
  active Boolean @default(true)
  lines ProductionLine[]
  qualityControls QualityControl[]
  controlSchedules ControlSchedule[]
  createdAt DateTime @default(now())
}

model ProductionLine {
  id String @id @default(cuid())
  siteId String
  code String @unique
  name String
  area String?
  active Boolean @default(true)
  site Site @relation(fields:[siteId], references:[id], onDelete:Restrict)
  machines Machine[]
  controls QualityControl[]
  controlSchedules ControlSchedule[]
  @@index([siteId])
}

model Machine {
  id String @id @default(cuid())
  lineId String
  code String @unique
  name String
  category String?
  active Boolean @default(true)
  line ProductionLine @relation(fields:[lineId], references:[id], onDelete:Restrict)
  controls QualityControl[]
}

model Product {
  id String @id @default(cuid())
  code String @unique
  name String
  category String?
  active Boolean @default(true)
  formats ProductFormat[]
  controls QualityControl[]
}

model ProductFormat {
  id String @id @default(cuid())
  productId String
  code String
  label String
  volumeMl Int?
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  controls QualityControl[]
  @@unique([productId,code])
}

model Shift {
  id String @id @default(cuid())
  code String @unique
  name String
  startTime String?
  endTime String?
  active Boolean @default(true)
  controls QualityControl[]
}

model QualityControl {
  id String @id @default(cuid())
  code String @unique
  siteId String?
  lineId String?
  machineId String?
  productId String?
  formatId String?
  shiftId String?
  line String?
  product String?
  format String?
  lotNumber String?
  shift String?
  controlDate DateTime @default(now())
  status QualityControlStatus @default(DRAFT)
  result String?
  notes String?
  latitude Float?
  longitude Float?
  gpsAccuracy Float?
  startedAt DateTime?
  submittedAt DateTime?
  createdById String?
  templateId String?
  // Le même moteur de contrôle sert désormais à tous les modules — ce
  // champ indique juste dans quel domaine ce contrôle-ci a été réalisé,
  // sans jamais renommer ni dupliquer l'entité elle-même.
  domain String @default("QUALITE")
  typeId String?
  // Liens universels vers les autres modules déjà existants — un
  // contrôle peut porter sur un EPI, un EPC, un risque, un fournisseur
  // ou un employé, en plus des liens qualité déjà en place.
  epiId String?
  epcId String?
  riskId String?
  fournisseurId String?
  employeeId String?
  // Taux de conformité calculé à la soumission — les points marqués non
  // applicables sont exclus du dénominateur, jamais comptés comme échec.
  conformityRate Float?
  // Décision finale — plus riche que le simple statut technique
  // COMPLIANT/NON_COMPLIANT : Conforme, Conforme sous réserve, Refusé,
  // Bloqué, Libéré, À recontrôler... configurable, jamais figée en dur.
  finalDecision String?
  // Échantillonnage (contrôles produit) — tout optionnel, sans incidence
  // sur les contrôles qui n'en ont pas besoin.
  lotSize Int?
  sampleSize Int?
  samplingMethod String?
  defectRate Float?
  acceptanceThreshold Float?
  rejectionThreshold Float?
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  productionLine ProductionLine? @relation(fields:[lineId], references:[id], onDelete:SetNull)
  machine Machine? @relation(fields:[machineId], references:[id], onDelete:SetNull)
  productRef Product? @relation(fields:[productId], references:[id], onDelete:SetNull)
  productFormat ProductFormat? @relation(fields:[formatId], references:[id], onDelete:SetNull)
  shiftRef Shift? @relation(fields:[shiftId], references:[id], onDelete:SetNull)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  template ControlTemplate? @relation(fields:[templateId], references:[id], onDelete:SetNull)
  type ControlType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  epc Epc? @relation(fields:[epcId], references:[id], onDelete:SetNull)
  risk Risk? @relation(fields:[riskId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  nonConformities NonConformity[]
  results ControlResult[]
  attachments QualityControlAttachment[]
  signatures QualityControlSignature[]
  @@index([controlDate])
  @@index([status])
  @@index([lineId,controlDate])
  @@index([productId,lotNumber])
  @@index([domain,controlDate])
}

// Catalogue des types de contrôle (contrôle qualité, réception, machine,
// hygiène, EPI/EPC...) — géré par l'administrateur, jamais une liste
// figée en dur. Un modèle de contrôle (ControlTemplate) appartient à un
// type ; un contrôle peut aussi référencer directement son type.
model ControlType {
  id String @id @default(cuid())
  code String @unique
  name String
  domain String @default("QUALITE")
  description String?
  active Boolean @default(true)
  templates ControlTemplate[]
  controls QualityControl[]
  schedules ControlSchedule[]
  createdAt DateTime @default(now())
}

// Planification des contrôles récurrents (section 9 du cahier des
// charges) : quotidien, hebdomadaire, mensuel, trimestriel, semestriel,
// annuel ou intervalle personnalisé. La génération du contrôle concret
// reste une action explicite (bouton "Générer maintenant") plutôt qu'une
// tâche automatique en arrière-plan — plus sûr, rien ne peut se
// déclencher tout seul de façon inattendue.
model ControlSchedule {
  id String @id @default(cuid())
  code String @unique
  name String
  domain String @default("QUALITE")
  typeId String?
  templateId String?
  frequency String
  intervalDays Int?
  assignedToId String?
  nextDueDate DateTime
  lastGeneratedAt DateTime?
  active Boolean @default(true)
  siteId String?
  lineId String?
  createdAt DateTime @default(now())
  type ControlType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  template ControlTemplate? @relation(fields:[templateId], references:[id], onDelete:SetNull)
  assignedTo User? @relation(fields:[assignedToId], references:[id], onDelete:SetNull)
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  productionLine ProductionLine? @relation(fields:[lineId], references:[id], onDelete:SetNull)
  @@index([nextDueDate,active])
}

model ControlTemplate {
  id String @id @default(cuid())
  code String @unique
  name String
  active Boolean @default(true)
  domain String @default("QUALITE")
  typeId String?
  type ControlType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  points ControlPoint[]
  controls QualityControl[]
  schedules ControlSchedule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ControlPoint {
  id String @id @default(cuid())
  templateId String
  code String
  label String
  type ControlValueType
  required Boolean @default(false)
  critical Boolean @default(false)
  minValue Float?
  maxValue Float?
  choices Json?
  unit String?
  order Int @default(0)
  template ControlTemplate @relation(fields:[templateId], references:[id], onDelete:Cascade)
  results ControlResult[]
  @@unique([templateId,code])
  @@index([templateId,order])
}

model ControlResult {
  id String @id @default(cuid())
  controlId String
  pointId String
  value Json?
  compliant Boolean?
  // Un point marqué non applicable ne compte ni comme conforme ni comme
  // non conforme — il doit être exclu du dénominateur du taux de
  // conformité, jamais traité comme un échec silencieux.
  notApplicable Boolean @default(false)
  comment String?
  photoRequired Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  control QualityControl @relation(fields:[controlId], references:[id], onDelete:Cascade)
  point ControlPoint @relation(fields:[pointId], references:[id], onDelete:Restrict)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  @@unique([controlId,pointId])
}

model QualityControlAttachment {
  id String @id @default(cuid())
  controlId String
  attachmentId String
  control QualityControl @relation(fields:[controlId], references:[id], onDelete:Cascade)
  attachment Attachment @relation(fields:[attachmentId], references:[id], onDelete:Cascade)
  @@unique([controlId,attachmentId])
}

model QualityControlSignature {
  id String @id @default(cuid())
  controlId String
  userId String?
  type SignatureType
  signatureData String
  signedAt DateTime @default(now())
  control QualityControl @relation(fields:[controlId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([controlId])
}

model Risk {
  id String @id @default(cuid())
  code String @unique
  hazard String
  activity String?
  severity Int
  probability Int
  control Int @default(1)
  score Int
  status String @default("ACTIVE")
  measures String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  qualityControls QualityControl[]
}

model HaccpRecord {
  id String @id @default(cuid())
  code String @unique
  process String
  step String
  hazard String
  ccp Boolean @default(false)
  criticalLimit String?
  monitoring String?
  result String?
  correctiveAction String?
  recordDate DateTime @default(now())
}

model QhseAudit {
  id String @id @default(cuid())
  code String @unique
  title String
  reference String?
  auditDate DateTime
  auditorId String?
  status String @default("PLANNED")
  score Float?
  findings Json?
  auditor User? @relation(fields:[auditorId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
}

model EnvironmentRecord {
  id String @id @default(cuid())
  code String @unique
  type String
  value Float?
  unit String?
  site String?
  recordedAt DateTime @default(now())
  notes String?
}

model Training {
  id String @id @default(cuid())
  code String @unique
  title String
  trainer String?
  scheduledAt DateTime
  durationHours Float?
  status String @default("PLANNED")
  participants Json?
  expiryAt DateTime?
}

model Equipment {
  id String @id @default(cuid())
  code String @unique
  name String
  category String?
  location String?
  status String @default("ACTIVE")
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  notes String?
}

model SafetyTalk {
  id String @id @default(cuid())
  weekStart DateTime
  weekEnd DateTime
  title String
  summary String
  status SafetyTalkStatus @default(DRAFT)
  generatedAt DateTime @default(now())
  approvedAt DateTime?
  createdById String?
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  @@unique([weekStart])
}

// ============================================================================
// Modules ajoutés pour compléter la parité avec la maquette Gestion QHSE 360
// (Qualité : processus/indicateurs, Réclamations, Fournisseurs, Hygiène,
// Veille réglementaire, Objectifs QHSE). Purement additif : aucun modèle
// existant ci-dessus n'est modifié.
// ============================================================================
model Processus {
  id String @id @default(cuid())
  code String @unique
  nom String
  proprietaire String?
  objectifs String?
  kpi String?
  createdAt DateTime @default(now())
}

model IndicateurQualite {
  id String @id @default(cuid())
  code String @unique
  indicateur String
  actuel Float
  cible Float
  unite String?
  sensInverse Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reclamation {
  id String @id @default(cuid())
  code String @unique
  client String
  motif String
  description String?
  date DateTime @default(now())
  gravite String @default("Faible")
  statut String @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fournisseur {
  id String @id @default(cuid())
  code String @unique
  nom String
  categorie String?
  scoreQualite Int?
  derniereEvaluation DateTime?
  statut String @default("HOMOLOGUE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  qualityControls QualityControl[]
}

model VisiteMedicale {
  id String @id @default(cuid())
  code String @unique
  employeNom String
  poste String?
  aptitude String?
  statut String @default("A_VENIR")
  prochaineVisite DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VeilleReglementaire {
  id String @id @default(cuid())
  code String @unique
  texte String
  domaine String?
  dateApplication DateTime?
  statut String @default("A_TRAITER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ObjectifQhse {
  id String @id @default(cuid())
  code String @unique
  titre String
  pilier String?
  cible Float
  actuel Float @default(0)
  unite String?
  echeance DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
