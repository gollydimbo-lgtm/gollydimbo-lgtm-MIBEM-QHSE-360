// ==========================================================
// MODULE HYGIÈNE AU TRAVAIL — PHASE 1 (schéma à ajouter)
// À coller dans schema.prisma, puis créer une migration
// nommée sur 4 chiffres, ex: 00XX_hygiene_travail_module
// ==========================================================

enum HygieneRiskCategorie {
  PHYSIQUE
  CHIMIQUE
  BIOLOGIQUE
  CONDITIONS_TRAVAIL
}

enum HygieneRiskStatut {
  IDENTIFIE
  EN_TRAITEMENT
  MAITRISE
  CLOTURE
}

enum HygieneRiskNiveau {
  FAIBLE
  MODERE
  ELEVE
  CRITIQUE
}

enum ExpositionConformite {
  CONFORME
  NON_CONFORME
  A_VERIFIER
}

enum ScoreErgonomique {
  FAIBLE
  MODERE
  ELEVE
  CRITIQUE
}

enum ZoneCorporelle {
  DOS
  EPAULES
  COU
  POIGNETS
  MAINS
  COUDES
  GENOUX
  JAMBES
  PIEDS
  AUTRE
}

enum TypeSignalementTMS {
  SITUATION_A_RISQUE
  CAS_DECLARE
}

enum TypeVisiteMedicale {
  EMBAUCHE
  PERIODIQUE
  REPRISE
  SPONTANEE
  SURVEILLANCE_RENFORCEE
}

enum StatutVisiteMedicale {
  REALISEE
  A_PROGRAMMER
  ECHUE
}

enum AptitudeStatut {
  APTE
  APTE_AVEC_RESTRICTIONS
  INAPTE
  EN_ATTENTE
}

model HygieneRisk {
  id                     String               @id @default(cuid())
  reference              String               @unique
  categorie              HygieneRiskCategorie
  sousType               String
  danger                 String
  situationDangereuse    String?
  source                 String?
  activite               String?
  poste                  String?
  zone                   String?
  siteId                 String?
  etablissement          String?
  service                String?
  departement            String?
  atelier                String?
  personnelExposeCount   Int                  @default(0)
  dureeExposition        String?
  frequenceExposition    String?
  voieExposition         String?
  niveauExposition       String?
  gravite                Int
  probabilite            Int
  criticite              Int
  niveauRisque           HygieneRiskNiveau
  mesuresExistantes      String?
  mesuresSupplementaires String?
  responsableId          String?
  echeance               DateTime?
  statut                 HygieneRiskStatut    @default(IDENTIFIE)
  riskId                 String?
  risk                   Risk?                @relation(fields: [riskId], references: [id])
  documentIds            Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  createdBy              String?
  updatedBy              String?

  expositions            HygieneExposureMonitoring[]
  actions                Action[]
}

model HygieneExposureMonitoring {
  id                String               @id @default(cuid())
  hygieneRiskId     String
  hygieneRisk       HygieneRisk          @relation(fields: [hygieneRiskId], references: [id])
  employeId         String?
  poste             String?
  zone              String?
  agentDangereux    String
  niveauExposition  String?
  frequence         String?
  duree             String?
  dateMesure        DateTime
  valeurMesuree     Float?
  uniteValeur       String?
  valeurLimite      Float?
  conformite        ExpositionConformite @default(A_VERIFIER)
  sourceMesure      String?
  evolution         String?
  mesuresPrevention String?
  createdAt         DateTime             @default(now())
  createdBy         String?
}

model ErgonomicAssessment {
  id                   String           @id @default(cuid())
  poste                String
  activite             String?
  service              String?
  siteId               String?
  facteurs             Json
  scoreValeur          Int
  scoreErgonomique     ScoreErgonomique
  tmsRisqueDetecte     Boolean          @default(false)
  actionsProposees     String?
  historiqueAvantApres Json?
  dateEvaluation       DateTime         @default(now())
  dateReevaluation     DateTime?
  responsableId        String?
  statut               String           @default("A_TRAITER")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdBy            String?

  tmsCases             TMSCase[]
  actions              Action[]
}

model TMSCase {
  id                    String               @id @default(cuid())
  ergonomicAssessmentId String?
  ergonomicAssessment   ErgonomicAssessment? @relation(fields: [ergonomicAssessmentId], references: [id])
  employeId             String?
  poste                 String?
  activite              String?
  zoneCorporelle        ZoneCorporelle
  typeSignalement       TypeSignalementTMS
  dateSignalement       DateTime             @default(now())
  frequence             String?
  gravitePercue         Int?
  statut                String               @default("OUVERT")
  actionsEngagees       String?
  efficaciteActions     String?
  safetyEventId         String?
  createdAt             DateTime             @default(now())
  createdBy             String?

  actions               Action[]
}

// Table à accès restreint — jamais exposée dans les tableaux de bord généraux
model MedicalSurveillance {
  id                  String               @id @default(cuid())
  employeId           String
  poste               String?
  service             String?
  dateDerniereVisite  DateTime?
  typeVisite          TypeVisiteMedicale?
  dateProchaineVisite DateTime?
  statutVisite        StatutVisiteMedicale @default(A_PROGRAMMER)
  aptitude            AptitudeStatut?
  restrictions        String?
  amenagementPoste    String?
  suiviParticulier    Boolean              @default(false)
  medecinService      String?
  documentIds         Json?
  dateRenouvellement  DateTime?
  confidentiel        Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdBy           String?
  updatedBy           String?
}

model PenibiliteFactor {
  id                      String   @id @default(cuid())
  nom                     String   @unique
  description             String?
  reglementationReference String?
  actif                   Boolean  @default(true)
  createdAt               DateTime @default(now())

  expositions             PenibiliteExposition[]
}

model PenibiliteExposition {
  id                    String           @id @default(cuid())
  employeId             String
  penibiliteFactorId    String
  penibiliteFactor      PenibiliteFactor @relation(fields: [penibiliteFactorId], references: [id])
  poste                 String?
  niveauExposition      String?
  duree                 String?
  frequence             String?
  mesuresPrevention     String?
  dateEvaluation        DateTime         @default(now())
  prochaineReevaluation DateTime?
  actionsNecessaires    String?
  createdAt             DateTime         @default(now())
  createdBy             String?

  actions               Action[]
}

