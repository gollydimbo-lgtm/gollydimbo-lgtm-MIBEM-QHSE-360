  employeNom String
  employeeId String?
  poste String?
  service String?
  typeVisite String?
  dateDerniereVisite DateTime?
  aptitude String?
  restrictions String?
  amenagementPoste String?
  medecinService String?
  suiviParticulier Boolean @default(false)
  statut String @default("A_VENIR")
  prochaineVisite DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
}

// Évaluation des risques sanitaires — catégories configurables
// (physique/chimique/biologique/conditions de travail), jamais une
// liste figée pour un seul secteur.
model RisqueSanitaire {
  id String @id @default(cuid())
  code String @unique
  categorie String?
  danger String
  source String?
  activite String?
  poste String?
  zone String?
  siteId String?
  processusId String?
  personnelExpose String?
  nombrePersonnesExposees Int?
  dureeExposition String?
  frequenceExposition String?
  voieExposition String?
  niveauExposition String?
  gravite Int @default(1)
  probabilite Int @default(1)
  criticite Int @default(1)
  mesuresExistantes String?
  mesuresSupplementaires String?
  responsableId String?
  echeance DateTime?
  statut String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  expositions ExpositionSurveillance[]
  actions Action[]
}

// Ergonomie des postes — le score se recalcule à chaque écriture à
// partir des facteurs cochés, jamais ressaisi séparément.
model AnalyseErgonomique {
  id String @id @default(cuid())
  code String @unique
  poste String
  zone String?
  siteId String?
  processusId String?
  stationDeboutProlongee Boolean @default(false)
  stationAssiseProlongee Boolean @default(false)
  travailRepetitif Boolean @default(false)
  manutentionChargesLourdes Boolean @default(false)
  posturesContraignantes Boolean @default(false)
  ecranInformatiquePosture Boolean @default(false)
  vibrations Boolean @default(false)
  eclairageInsuffisant Boolean @default(false)
  espaceInsuffisant Boolean @default(false)
  observations String?
  scoreErgonomique String @default("FAIBLE")
  actionsProposees String?
  dateEvaluation DateTime @default(now())
  evaluateurId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  evaluateur User? @relation(fields:[evaluateurId], references:[id], onDelete:SetNull)
