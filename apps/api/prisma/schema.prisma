// ============================================================================
// MODULE OBJECTIFS QHSE — Phase 1 : fondations, classification SMART,
// cibles, KPI (manuels ou auto-alimentés depuis les moteurs d'indicateurs
// déjà existants — indicateursAuto(), reclamationsScoreGlobal(),
// hygieneIndiceGlobal(), environnementDashboard() — jamais un second calcul
// divergent), actions CAPA liées (Action.objectifQhseId), risques/
// opportunités liés, commentaires de suivi, revues périodiques et
// checklist de recette CA-01..CA-49. Les champs existants (pilier,
// valeurInitiale, cible, actuel, sensInverse, unite, echeance,
// responsableId, budget, processusId) sont conservés tels quels : aucune
// donnée existante n'est perdue.
model ObjectifQhse {
  id String @id @default(cuid())
  code String @unique
  titre String
  description String?
  pilier String?
  // Famille QHSE (point 3 du cahier des charges) — distincte de `pilier`
  // (libre, historique) : valeurs attendues QUALITE|HYGIENE|SECURITE|
  // ENVIRONNEMENT|TRANSVERSAL.
  famille String @default("TRANSVERSAL")
  // Classification (point 4.2) — STRATEGIQUE|TACTIQUE|OPERATIONNEL|
  // REGLEMENTAIRE|CLIENT|AMELIORATION_CONTINUE|CONFORMITE|PREVENTION.
  classification String?
  categorie String?
  activiteConcernee String?
  zone String?
  valeurInitiale Float?
  dateReference DateTime?
  cible Float
  actuel Float @default(0)
  sensInverse Boolean @default(false)
  unite String?
  seuilMin Float?
  seuilMax Float?
  // QUOTIDIENNE|HEBDOMADAIRE|MENSUELLE|TRIMESTRIELLE|SEMESTRIELLE|ANNUELLE
  frequenceMesure String?
  dateDebut DateTime?
  echeance DateTime?
  responsableId String?
  // Contributeurs — tableau d'ids utilisateur (Postgres natif), pas de
  // table de jointure : évite l'ambiguïté de relations multiples vers
  // User tout en couvrant le besoin du point 9 (pilote/contributeurs).
  contributeurIds String[] @default([])
  valideurId String?
  directionResponsable String?
  budget Float?
  // CRITIQUE|HAUTE|MOYENNE|FAIBLE
  priorite String?
  importanceStrategique String?
  // Permet de figer manuellement SUSPENDU/ABANDONNE — sinon le statut est
  // toujours recalculé à la lecture (jamais de valeur figée qui diverge).
  statutManuel String?
  annee Int?
  dupliqueDeId String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String?
  updatedById String?
  processusId String?
  siteId String?
  workUnitId String?
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  kpis ObjectifKpi[]
  objectifRisks ObjectifRisk[]
  comments ObjectifComment[]
  reviews ObjectifReview[]
  actions Action[]
}

// KPI lié à un objectif (point 7) — soit alimenté manuellement, soit
// « AUTO » : dans ce cas sourceKey pointe vers une clé du catalogue
// objectifKpiCatalog() et valeurActuelle n'est jamais stockée durablement,
// toujours recalculée à la lecture depuis le moteur source (même principe
// que le statut des preuves de la Veille réglementaire).
model ObjectifKpi {
  id String @id @default(cuid())
  objectifId String
  nom String
  definition String?
  formule String?
  unite String?
  frequence String?
  sourceType String @default("MANUEL")
  sourceKey String?
  sourceModule String?
  responsableId String?
  valeurInitiale Float?
  cible Float?
  valeurActuelle Float?
  sensInverse Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  objectif ObjectifQhse @relation(fields:[objectifId], references:[id], onDelete:Cascade)
}

// Risque ou opportunité lié à un objectif (point 17) — table de jointure
// vers le Registre des Risques existant, jamais de duplication du risque.
model ObjectifRisk {
  id String @id @default(cuid())
  objectifId String
  riskId String
  type String @default("RISQUE")
  niveauRisque String?
  mesuresMaitrise String?
  createdAt DateTime @default(now())
  objectif ObjectifQhse @relation(fields:[objectifId], references:[id], onDelete:Cascade)
  risk Risk @relation(fields:[riskId], references:[id], onDelete:Cascade)
  @@unique([objectifId, riskId])
}

// Commentaire de suivi (point 18) — append-only, l'historique complet
// reste consultable (jamais de modification destructive).
model ObjectifComment {
  id String @id @default(cuid())
  objectifId String
  type String @default("SUIVI")
  contenu String
  auteurId String?
  createdAt DateTime @default(now())
  objectif ObjectifQhse @relation(fields:[objectifId], references:[id], onDelete:Cascade)
}

// Revue périodique (point 19) — jamais écrasée, historique complet
// conservé dans l'ordre chronologique (CA-38).
model ObjectifReview {
  id String @id @default(cuid())
  objectifId String
  periodicite String?
  dateRevue DateTime @default(now())
  resultats String?
  ecarts String?
  analyseCauses String?
  decision String?
  nouvelleCible Float?
  actionsProposees String?
  commentaire String?
  createdById String?
  createdAt DateTime @default(now())
  objectif ObjectifQhse @relation(fields:[objectifId], references:[id], onDelete:Cascade)
}

// Checklist de recette du module (point 38, CA-01 à CA-49) — un
// enregistrement par critère d'acceptation, seedé une fois à la migration
// et mis à jour par le développeur/administrateur au fil des tests.
model ObjectifRecetteCriterion {
  id String @id @default(cuid())
  code String @unique
  categorie String?
  libelle String
  statut String @default("NON_TESTE")
  dateTest DateTime?
  testeurId String?
  commentaire String?
  anomalie String?
  dateCorrection DateTime?
  resultatRetest String?
  updatedAt DateTime @updatedAt
}

// ============================================================================
// MODULE VEILLE RÉGLEMENTAIRE — Phase 1 : fondations et chaîne centrale.
// Additif : le modèle VeilleReglementaire existant (catalogue simple, lié
// depuis Document) n'est ni modifié ni supprimé. Les modèles ci-dessous
// construisent la chaîne complète Texte → Exigence → Applicabilité →
// Évaluation → Preuve → NC → CAPA → Risque, avec des tables de liaison
// plutôt que des duplications de données ("une donnée = une source").
// ============================================================================

// Domaines de veille activables/désactivables selon le secteur de
// l'entreprise (point 3 et 28 du cahier des charges) — configurable plutôt
// qu'un enum figé dans le code.
model RegulatoryDomain {
  id String @id @default(cuid())
  code String @unique
  label String
  actif Boolean @default(true)
  order Int @default(0)
  texts RegulatoryText[]
  requirements RegulatoryRequirement[]
}

// Paramétrage du module — seuils d'alertes et méthode de calcul du taux de
// conformité, modifiables par l'administrateur sans toucher au code (même
// principe que EquipmentSettings/NcSettings).
model RegulatorySettings {
  id String @id @default(cuid())
  alerteJ90 Boolean @default(true)
  alerteJ60 Boolean @default(true)
  alerteJ30 Boolean @default(true)
  alerteJ15 Boolean @default(true)
  alerteJ7 Boolean @default(true)
  methodeCalculTaux String @default("STANDARD")
  updatedAt DateTime @updatedAt
}

// Fiche complète d'un texte réglementaire (point 4). Une exigence
// (RegulatoryRequirement) est toujours rattachée à un texte : le texte
// porte les métadonnées de la source, l'exigence porte l'obligation
// concrète à respecter.
model RegulatoryText {
  id String @id @default(cuid())
  code String @unique
  reference String?
  titre String
  typeTexte String?
  domainId String?
  sousDomaine String?
  pays String?
  autoriteEmettrice String?
  datePublication DateTime?
  dateEntreeVigueur DateTime?
  dateDerniereModification DateTime?
  dateAbrogation DateTime?
  version String?
  statut String @default("EN_VIGUEUR")
  sourceOfficielle String?
  lienSource String?
  resume String?
  objet String?
  articlesApplicables String?
  entreprisesConcernees String?
  sitesConcernes String?
  activitesConcernees String?
  derniereVerificationSource DateTime?
  verifieParId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain RegulatoryDomain? @relation(fields:[domainId], references:[id], onDelete:SetNull)
  verifiePar User? @relation("RegulatoryTextVerifiePar", fields:[verifieParId], references:[id], onDelete:SetNull)
  requirements RegulatoryRequirement[]
}

// Exigence unique extraite d'un texte (points 2, 5, 6, 21) — objet central
// de la matrice réglementaire dynamique. Le statut d'applicabilité et de
// conformité affichés ici sont dénormalisés depuis la dernière évaluation
// pour permettre des filtres/tris rapides côté matrice, mais la vérité
// historique reste dans RegulatoryEvaluation.
model RegulatoryRequirement {
  id String @id @default(cuid())
  code String @unique
  textId String
  libelle String
  domainId String?
  siteId String?
  workUnitId String?
  preuveAttendue String?
  responsableId String?
  frequenceEvaluationMois Int?
  dateDerniereEvaluation DateTime?
  dateProchaineEvaluation DateTime?
  criticite String?
  applicabilite String @default("A_ANALYSER")
  justificatifApplicabilite String?
  statutConformite String?
  statutFile String @default("NOUVEAU")
  commentaire String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  text RegulatoryText @relation(fields:[textId], references:[id], onDelete:Cascade)
  domain RegulatoryDomain? @relation(fields:[domainId], references:[id], onDelete:SetNull)
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  responsable User? @relation("RegulatoryRequirementResponsable", fields:[responsableId], references:[id], onDelete:SetNull)
  evaluations RegulatoryEvaluation[]
  evidences RegulatoryEvidence[]
  nonConformities NonConformity[]
  actions Action[]
  requirementRisks RegulatoryRequirementRisk[]
  requirementDocuments RegulatoryRequirementDocument[]
  riskReevaluationRequests RegulatoryRiskReevaluationRequest[]
}

// Historique des évaluations de conformité (point 7) — une ligne par
// contrôle réalisé dans le temps, jamais écrasée.
model RegulatoryEvaluation {
  id String @id @default(cuid())
  requirementId String
  statut String
  constat String?
  preuveExaminee String?
  observation String?
  personneInterrogee String?
  dateControle DateTime @default(now())
  evaluateurId String?
  criticite String?
  commentaire String?
  createdAt DateTime @default(now())
  requirement RegulatoryRequirement @relation(fields:[requirementId], references:[id], onDelete:Cascade)
  evaluateur User? @relation("RegulatoryEvaluationEvaluateur", fields:[evaluateurId], references:[id], onDelete:SetNull)
}

// Preuve de conformité associée à une exigence (point 8) — peut pointer
// vers un document GED existant (evidence "papier" déjà classée) ou rester
// autonome (référence/nom libre) quand le document n'est pas encore dans
// la GED.
model RegulatoryEvidence {
  id String @id @default(cuid())
  requirementId String
  type String?
  documentId String?
  nom String?
  dateEmission DateTime?
  dateExpiration DateTime?
  responsableId String?
  statut String @default("VALIDE")
  commentaire String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requirement RegulatoryRequirement @relation(fields:[requirementId], references:[id], onDelete:Cascade)
  document Document? @relation(fields:[documentId], references:[id], onDelete:SetNull)
  responsable User? @relation("RegulatoryEvidenceResponsable", fields:[responsableId], references:[id], onDelete:SetNull)
}

// Liaison exigence ↔ risque (plusieurs-à-plusieurs, point 10-11 et 36) —
// table de jointure plutôt que duplication du risque dans la fiche exigence.
model RegulatoryRequirementRisk {
  id String @id @default(cuid())
  requirementId String
  riskId String
  note String?
  createdAt DateTime @default(now())
  requirement RegulatoryRequirement @relation(fields:[requirementId], references:[id], onDelete:Cascade)
  risk Risk @relation(fields:[riskId], references:[id], onDelete:Cascade)
  @@unique([requirementId, riskId])
}

// Liaison exigence ↔ document GED (plusieurs-à-plusieurs, point 13 et 36) —
// distincte de RegulatoryEvidence : couvre aussi les procédures/instructions
// liées sans valeur de preuve d'expiration.
model RegulatoryRequirementDocument {
  id String @id @default(cuid())
  requirementId String
  documentId String
  type String?
  createdAt DateTime @default(now())
  requirement RegulatoryRequirement @relation(fields:[requirementId], references:[id], onDelete:Cascade)
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)
  @@unique([requirementId, documentId])
}

// ============================================================================
// MODULE VEILLE RÉGLEMENTAIRE — Phase 2 : alertes, échéances, workflow
// d'analyse d'impact et réévaluation des risques.
// ============================================================================

// Demande de réévaluation d'un risque suite à une évolution réglementaire
// (points 11-12 du prompt d'interconnexion) — jamais une modification
// automatique de la cotation, toujours une tâche à traiter par un humain.
model RegulatoryRiskReevaluationRequest {
  id String @id @default(cuid())
  requirementId String?
  riskId String
  raison String?
  responsableId String?
  dateLimite DateTime?
  statut String @default("A_PLANIFIER")
  // Généralisation (chantier "moteur de réévaluation croisée des risques") :
  // au départ ces demandes ne venaient que d'une évolution réglementaire
  // (requirementId obligatoire). sourceModule/sourceKey/sourceEntityId
  // permettent au même mécanisme d'être déclenché par d'autres signaux du
  // système (accident grave, non-conformités récurrentes liées au risque),
  // en réutilisant le motif idempotent déjà utilisé par detecterBesoinsFormation :
  // sourceKey est unique, donc relancer la détection ne duplique jamais une
  // proposition déjà créée, quel que soit son statut.
  sourceModule String @default("REGLEMENTAIRE")
  sourceKey String? @unique
  sourceEntityId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requirement RegulatoryRequirement? @relation(fields:[requirementId], references:[id], onDelete:Cascade)
  risk Risk @relation(fields:[riskId], references:[id], onDelete:Cascade)
  responsable User? @relation("RegulatoryReevalResponsable", fields:[responsableId], references:[id], onDelete:SetNull)
}

// Rapports QHSE — identite de l'entreprise reutilisee automatiquement dans
// les rapports generes (page de garde, en-tete). Table singleton : une seule
// ligne, jamais une base parallele aux modules metier.
model CompanyIdentity {
  id String @id @default(cuid())
  nomOfficiel String?
  nomCommercial String?
  sigle String?
  slogan String?
  logoUrl String?
  adresse String?
  telephone String?
  email String?
  siteInternet String?
  pays String?
  responsableQhseId String?
  directeurId String?
  responsableRapportId String?
  updatedById String?
  updatedAt DateTime @updatedAt
}

// Rapports QHSE — Phase 3 : le rapport devient une entite persistee, avec
// statut/version et un contenu editorial (avis QHSE, observations Direction,
// conclusion) explicitement separe de "donnees" (instantane fige du moteur
// de consolidation au moment de la creation, jamais recalcule silencieusement
// ni modifiable — corriger une donnee source se fait dans son module
// d'origine, pas ici). Un rapport VALIDE ou DISTRIBUE est verrouille cote
// service : toute modification cree une nouvelle version (versionOfId).
model RapportQhse {
  id String @id @default(cuid())
  titre String
  mode String @default("COMPLET")
  domaineThematique String?
  periodeFrom DateTime
  periodeTo DateTime
  siteId String?
  confidentialite String?
  statut String @default("BROUILLON")
  version Int @default(1)
  versionGroupId String?
  versionOfId String?
  donnees Json
  analyseQhse String?
  observationsDirection String?
  conclusion String?
  preparePar String?
  prepareParDate DateTime?
  verifiePar String?
  verifieParDate DateTime?
  validePar String?
  valideParDate DateTime?
  createdById String?
  documentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  document Document? @relation(fields:[documentId], references:[id], onDelete:SetNull)
  distributions RapportDistribution[]
}

// Traçabilité de diffusion (point 32) — qui a reçu quelle version, quand,
// distribuée par qui.
model RapportDistribution {
  id String @id @default(cuid())
  rapportId String
  destinataireId String?
  destinataireEmail String?
  distribuePar String?
  dateDistribution DateTime @default(now())
  version Int
  rapport RapportQhse @relation(fields:[rapportId], references:[id], onDelete:Cascade)
  destinataire User? @relation(fields:[destinataireId], references:[id], onDelete:SetNull)
}
