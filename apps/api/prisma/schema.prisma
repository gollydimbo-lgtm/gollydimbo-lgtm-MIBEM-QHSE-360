generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleName {
  ADMINISTRATEUR
  RESPONSABLE_QHSE
  ASSISTANT_QHSE
  CONTROLEUR_QUALITE
  CHEF_PRODUCTION
  OPERATEUR
  AUDITEUR
  CONSULTATION
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum EpiFrequency {
  DAILY
  ANNUAL
}

enum EpiMovementType {
  RECEIPT
  DAILY_DISTRIBUTION
  ANNUAL_DISTRIBUTION
  REPLACEMENT
  LOSS
  DAMAGE
  ADJUSTMENT
  RETURN
  REFORM
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

enum SafetyTalkStatus {
  DRAFT
  APPROVED
  DELIVERED
  ANNULE
  REPORTE
}

enum QualityControlStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  COMPLIANT
  NON_COMPLIANT
  CANCELLED
}

enum ControlValueType {
  BOOLEAN
  NUMERIC
  TEXT
  CHOICE
  PHOTO
  DATE
  TIME
  PERCENTAGE
  SIGNATURE
  RATING
}

enum SignatureType {
  CONTROLLER
  RESPONSIBLE
  VALIDATOR
}

enum AttachmentOwnerType {
  QUALITY_CONTROL
  NON_CONFORMITY
  ACTION
  SAFETY_EVENT
  RISK
  AUDIT
  EPI
  DOCUMENT
  SAFETY_TALK
  HACCP
  HACCP_CCP
}

enum QualityShift {
  MORNING
  AFTERNOON
  NIGHT
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  firstName String
  lastName String
  status UserStatus @default(ACTIVE)
  employeeId String? @unique
  roles UserRole[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
  besoinsFormationTraites BesoinFormation[]
  evaluationsEfficaciteRealisees TrainingEfficaciteEvaluation[]
  attachments Attachment[]
  documentsCreated Document[] @relation("DocumentCreator")
  documentsResponsable Document[] @relation("DocumentResponsable")
  documentsVerification Document[] @relation("DocumentVerificateur")
  documentsApprobation Document[] @relation("DocumentApprobateur")
  documentApprovalsDecided DocumentApproval[]
  documentDiffusionsCreated DocumentDiffusion[]
  documentDiffusionRecipient DocumentDiffusionRecipient[]
  documentLinksCreated DocumentLink[]
  epiMovements EpiMovement[]
  safetyTalks SafetyTalk[]
  safetyTalksAnimation SafetyTalk[] @relation("SafetyTalkAnimateur")
  safetyTalkParticipations SafetyTalkParticipant[]
  safetyTalkFeedbacksReported SafetyTalkFeedback[]
  actionsResponsible Action[]
  qualityControls QualityControl[]
  qualitySignatures QualityControlSignature[]
  controlResults ControlResult[]
  audits QhseAudit[] @relation("AuditAuditor")
  auditsAsResponsable QhseAudit[] @relation("AuditResponsable")
  auditProgramsAsAuditeur AuditProgram[]
  auditFindingsResponsable AuditFinding[]
  auditorProfile AuditorProfile?
  auditSignatures AuditSignature[]
  nonConformitiesDeclarees NonConformity[] @relation("NcDeclarant")
  nonConformitiesResponsable NonConformity[] @relation("NcResponsible")
  ncContainmentActionsResponsable NcContainmentAction[]
  actionExtensionsDemandees ActionExtension[] @relation("ActionExtensionDemandeur")
  actionExtensionsValidees ActionExtension[] @relation("ActionExtensionValidateur")
  capaLinksCreated CapaLink[]
  refreshTokens RefreshToken[]
  epcResponsible Epc[]
  epcInspections EpcInspection[]
  epiInspections EpiInspection[]
  epiAssignmentsResponsible EpiAssignment[]
  epcMaintenancesPerformed EpcMaintenance[]
  controlSchedulesAssigned ControlSchedule[]
  processusAsPilote Processus[] @relation("ProcessusPilote")
  processusAsSuppleant Processus[] @relation("ProcessusSuppleant")
  processusActivitiesResponsible ProcessusActivity[] @relation("ProcessusActivityResponsible")
  processusRacis ProcessusRaci[]
  processusExigencesResponsable ProcessusExigence[]
  reclamationsActionCurative Reclamation[]
  fournisseursResponsable Fournisseur[]
  equipmentsResponsable Equipment[] @relation("EquipmentResponsable")
  equipmentMaintenancePlans EquipmentMaintenancePlan[]
  equipmentMaintenanceRecords EquipmentMaintenanceRecord[]
  equipmentControls EquipmentControl[]
  equipmentInspections EquipmentInspection[]
  equipmentConsignations EquipmentConsignation[]
  safetyEventsEnquete SafetyEvent[]
  risquesSanitairesResponsable RisqueSanitaire[]
  analysesErgonomiquesEvaluateur AnalyseErgonomique[]
  environnementAspectsResponsable EnvironnementAspect[]
  objectifsQhseResponsable ObjectifQhse[]
  veilleReglementaireResponsable VeilleReglementaire[]
  regulatoryTextsVerifiees RegulatoryText[] @relation("RegulatoryTextVerifiePar")
  regulatoryRequirementsResponsable RegulatoryRequirement[] @relation("RegulatoryRequirementResponsable")
  regulatoryEvaluationsRealisees RegulatoryEvaluation[] @relation("RegulatoryEvaluationEvaluateur")
  regulatoryEvidencesResponsable RegulatoryEvidence[] @relation("RegulatoryEvidenceResponsable")
  regulatoryReevalResponsable RegulatoryRiskReevaluationRequest[] @relation("RegulatoryReevalResponsable")
  riskMeasuresResponsable RiskMeasure[]
  riskEvaluationsRealisees RiskEvaluation[]
  haccpStudiesResponsable HaccpStudy[]
  haccpTeamMemberships HaccpTeamMember[]
  haccpStepsResponsable HaccpProcessStep[]
  haccpCcpsResponsable HaccpCcp[]
  haccpMonitoringResponsable HaccpMonitoringRecord[]
  haccpPrpsResponsable HaccpPrp[]
  haccpRevisionsResponsable HaccpRevision[]
  rapportsQhseCrees RapportQhse[]
  rapportDistributionsRecues RapportDistribution[]
}

model Role {
  id String @id @default(cuid())
  name RoleName @unique
  permissions RolePermission[]
  users UserRole[]
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  role Role @relation(fields:[roleId], references:[id], onDelete: Cascade)
  @@id([userId,roleId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields:[roleId], references:[id], onDelete: Cascade)
  permission Permission @relation(fields:[permissionId], references:[id], onDelete: Cascade)
  @@id([roleId,permissionId])
}

model RefreshToken {
  id String @id @default(cuid())
  tokenHash String
  userId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  module String
  entityId String?
  oldValue Json?
  newValue Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user User? @relation(fields:[userId], references:[id], onDelete: SetNull)
  @@index([module,entityId])
  @@index([createdAt])
}

model Attachment {
  id String @id @default(cuid())
  originalName String
  storagePath String
  mimeType String
  size Int
  sha256 String?
  uploadedById String?
  documentId String?
  createdAt DateTime @default(now())
  uploadedBy User? @relation(fields:[uploadedById], references:[id], onDelete:SetNull)
  document Document? @relation(fields:[documentId], references:[id], onDelete: Cascade)
  links AttachmentLink[]
  qualityControlLinks QualityControlAttachment[]
  @@index([documentId])
}

// Liaison générique attachment <-> entité métier (accident, NC, risque, audit, EPI...).
// Complète QualityControlAttachment qui reste dédiée au contrôle qualité pour compatibilité.
model AttachmentLink {
  id String @id @default(cuid())
  ownerType AttachmentOwnerType
  ownerId String
  attachmentId String
  createdAt DateTime @default(now())
  attachment Attachment @relation(fields:[attachmentId], references:[id], onDelete:Cascade)
  @@unique([ownerType,ownerId,attachmentId])
  @@index([ownerType,ownerId])
}

// Classification transverse en 5 groupes du référentiel documentaire QHSE
// (Stratégie/Contexte, Risques/Sécurité/Conformité, Supports/Maîtrise
// documentaire, Opérations/Maîtrise terrain, Évaluation/Contrôle/Amélioration).
// Vient EN PLUS du champ "category" existant, sans le remplacer : purement
// additif, aucune donnée existante n'est modifiée par ce changement de schéma.
enum DocumentGroup {
  STRATEGIE_CONTEXTE
  RISQUES_SECURITE_CONFORMITE
  SUPPORTS_MAITRISE_DOCUMENTAIRE
  OPERATIONS_MAITRISE_TERRAIN
  EVALUATION_CONTROLE_AMELIORATION
}

model Document {
  id String @id @default(cuid())
  code String @unique
  title String
  category String
  documentGroup DocumentGroup?
  status DocumentStatus @default(DRAFT)
  currentVersion Int @default(1)
  createdById String?
  processusId String?
  // Prochaine date de révision — sans elle, aucune alerte d'échéance
  // documentaire n'a de sens à calculer.
  nextReviewAt DateTime?
  description String?
  documentType String?
  domaine String?
  service String?
  activite String?
  siteId String?
  responsibleId String?
  verificateurId String?
  approbateurId String?
  dateEntreeVigueur DateTime?
  frequenceRevision String?
  criticite String @default("NON_CRITIQUE")
  motifCreation String?
  referencesReglementaires String?
  referencesNormatives String?
  motsCles String?
  workUnitId String?
  external Boolean @default(false)
  sourceOrganisme String?
  externalReference String?
  qrToken String? @unique
  diffusionAccuseRequis Boolean @default(false)
  veilleReglementaireId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User? @relation("DocumentCreator", fields:[createdById], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  responsible User? @relation("DocumentResponsable", fields:[responsibleId], references:[id], onDelete:SetNull)
  verificateur User? @relation("DocumentVerificateur", fields:[verificateurId], references:[id], onDelete:SetNull)
  approbateur User? @relation("DocumentApprobateur", fields:[approbateurId], references:[id], onDelete:SetNull)
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  veilleReglementaire VeilleReglementaire? @relation(fields:[veilleReglementaireId], references:[id], onDelete:SetNull)
  versions DocumentVersion[]
  attachments Attachment[]
  approvals DocumentApproval[]
  diffusions DocumentDiffusion[]
  links DocumentLink[]
  regulatoryEvidences RegulatoryEvidence[]
  regulatoryRequirementLinks RegulatoryRequirementDocument[]
  rapportsQhse RapportQhse[]
}

model DocumentVersion {
  id String @id @default(cuid())
  documentId String
  version Int
  fileName String
  storagePath String
  checksum String?
  status DocumentStatus @default(DRAFT)
  motifModification String?
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)
  @@unique([documentId,version])
}

// Traçabilité des décisions du circuit de validation (vérification, approbation,
// refus, demande de modification) — une version non approuvée ne doit jamais
// être considérée comme la version officielle.
model DocumentApproval {
  id String @id @default(cuid())
  documentId String
  version Int
  userId String?
  role String
  decision String
  comment String?
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([documentId])
}

// Diffusion documentaire — qui a reçu quelle version, et accusé de lecture.
model DocumentDiffusion {
  id String @id @default(cuid())
  documentId String
  version Int
  createdById String?
  createdAt DateTime @default(now())
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  recipients DocumentDiffusionRecipient[]
}

model DocumentDiffusionRecipient {
  id String @id @default(cuid())
  diffusionId String
  userId String?
  label String?
  accuseRequis Boolean @default(false)
  statutLecture String @default("NON_LU")
  dateLecture DateTime?
  createdAt DateTime @default(now())
  diffusion DocumentDiffusion @relation(fields:[diffusionId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([diffusionId])
}

// Matrice de liaison générique document <-> n'importe quel module (même principe
// que CapaLink, éprouvé ailleurs dans l'application) — permet à CHAQUE module
// (NC, Audit, Risque, CAPA, Processus, HACCP, EPI, Formation, etc.) de relier un
// document sans FK dédiée par module.
model DocumentLink {
  id String @id @default(cuid())
  documentId String
  sourceModule String
  sourceEntityId String
  relationType String @default("ASSOCIE")
  metadata Json?
  createdAt DateTime @default(now())
  createdById String?
  document Document @relation(fields:[documentId], references:[id], onDelete:Cascade)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  @@index([sourceModule,sourceEntityId])
  @@index([documentId])
}

// Types de documents configurables par l'administrateur (jamais une liste figée) —
// section "types de documents personnalisables" du cahier des charges GED.
model DocumentType {
  id String @id @default(cuid())
  code String @unique
  name String
  prefix String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
}

// Arborescence documentaire configurable par l'administrateur — jamais imposée
// à un secteur d'activité donné.
model DocumentCategoryNode {
  id String @id @default(cuid())
  name String
  parentId String?
  ordre Int @default(0)
  parent DocumentCategoryNode? @relation("CategoryTree", fields:[parentId], references:[id], onDelete:Cascade)
  children DocumentCategoryNode[] @relation("CategoryTree")
  createdAt DateTime @default(now())
}

// Catégories EPI — table gérable par l'administrateur, jamais une liste
// figée en dur (le cahier des charges l'exige explicitement).
model EpiCategory {
  id String @id @default(cuid())
  name String @unique
  epis Epi[]
}

model Epi {
  id String @id @default(cuid())
  code String @unique
  name String
  frequency EpiFrequency
  unit String @default("piece")
  annualValidityDays Int?
  minStock Int @default(0)
  active Boolean @default(true)
  movements EpiMovement[]
  assignments EpiAssignment[]
  categoryId String?
  category EpiCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  reference String?
  subcategory String?
  description String?
  manufacturer String?
  model String?
  size String?
  color String?
  material String?
  standard String?
  // Mode de durée d'utilisation — jamais une valeur universelle : configurable
  // équipement par équipement, selon le fabricant, la réglementation,
  // l'analyse des risques, l'usage et l'état constaté en inspection.
  durationMode String?
  durationValueDays Int?
  disposable Boolean @default(false)
  shared Boolean @default(false)
  maxStock Int?
  location String?
  status String @default("ACTIVE")
  inspections EpiInspection[]
  jobRiskProtections JobRiskProtection[]
  nonConformities NonConformity[]
  qualityControls QualityControl[]
  safetyEvents SafetyEvent[]
  riskMeasures RiskMeasure[]
}

model Employee {
  id String @id @default(cuid())
  matricule String @unique
  firstName String
  lastName String
  department String?
  position String?
  active Boolean @default(true)
  epiAssignments EpiAssignment[]
  epiMovements EpiMovement[]
  epiInspections EpiInspection[]
  qualityControls QualityControl[]
  safetyEvents SafetyEvent[]
  visitesMedicales VisiteMedicale[]
  expositions ExpositionSurveillance[]
  tmsSignalements TmsSignalement[]
  penibiliteExpositions PenibiliteExposition[]
  safetyTalkParticipations SafetyTalkParticipant[]
  haccpTeamMemberships HaccpTeamMember[]
  habilitations Habilitation[]
  trainingParticipations TrainingParticipant[]
  competences EmployeeCompetence[]
  besoinsFormation BesoinFormation[]
  evaluationsEfficacite TrainingEfficaciteEvaluation[]
}

model EpiAssignment {
  id String @id @default(cuid())
  code String @unique
  employeeId String
  epiId String
  quantity Int
  size String?
  distributedAt DateTime
  renewalAt DateTime?
  expectedDurationDays Int?
  condition String?
  reason String?
  status String @default("ACTIVE")
  responsibleId String?
  // Signatures électroniques — stockées en base64 (image PNG dessinée),
  // jamais un simple champ texte "signé par" : preuve réelle de la remise.
  employeeSignature String?
  responsibleSignature String?
  employee Employee @relation(fields:[employeeId], references:[id], onDelete:Cascade)
  epi Epi @relation(fields:[epiId], references:[id], onDelete:Restrict)
  responsible User? @relation(fields:[responsibleId], references:[id], onDelete:SetNull)
  @@index([employeeId,epiId])
}

model EpiMovement {
  id String @id @default(cuid())
  epiId String
  type EpiMovementType
  quantity Int
  employeeId String?
  distributionDate DateTime @default(now())
  userId String?
  note String?
  epi Epi @relation(fields:[epiId], references:[id], onDelete:Restrict)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([epiId,distributionDate])
}

// Checklist d'inspection EPI (casque, harnais, chaussures...) — résultat
// standardisé, jamais une simple case cochée/décochée.
model EpiInspection {
  id String @id @default(cuid())
  epiId String
  epi Epi @relation(fields:[epiId], references:[id], onDelete:Cascade)
  employeeId String?
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  inspectedAt DateTime @default(now())
  result String
  observations String?
  inspectedById String?
  inspectedBy User? @relation(fields:[inspectedById], references:[id], onDelete:SetNull)
}

// Catégories EPC — table gérable par l'administrateur, comme pour les EPI.
model EpcCategory {
  id String @id @default(cuid())
  name String @unique
  epcs Epc[]
}

model Epc {
  id String @id @default(cuid())
  code String @unique
  name String
  categoryId String?
  category EpcCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  location String?
  zone String?
  description String?
  manufacturer String?
  model String?
  reference String?
  installedAt DateTime?
  responsibleId String?
  responsible User? @relation(fields:[responsibleId], references:[id], onDelete:SetNull)
  condition String?
  status String @default("ACTIVE")
  inspectionFrequencyDays Int?
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  notes String?
  inspections EpcInspection[]
  jobRiskProtections JobRiskProtection[]
  nonConformities NonConformity[]
  maintenances EpcMaintenance[]
  qualityControls QualityControl[]
  safetyEvents SafetyEvent[]
}

model EpcInspection {
  id String @id @default(cuid())
  epcId String
  epc Epc @relation(fields:[epcId], references:[id], onDelete:Cascade)
  inspectedAt DateTime @default(now())
  result String
  observations String?
  inspectedById String?
  inspectedBy User? @relation(fields:[inspectedById], references:[id], onDelete:SetNull)
}

// Historique de maintenance EPC — préventive ou corrective, avec la
// prochaine échéance pour pouvoir la suivre dans le temps.
model EpcMaintenance {
  id String @id @default(cuid())
  epcId String
  epc Epc @relation(fields:[epcId], references:[id], onDelete:Cascade)
  date DateTime @default(now())
  type String
  description String?
  cost Float?
  performedById String?
  performedBy User? @relation(fields:[performedById], references:[id], onDelete:SetNull)
  nextMaintenanceAt DateTime?
  status String @default("DONE")
}

// La matrice Poste → Activité → Danger → Risque → Mesure de prévention →
// EPC/EPI → Fréquence d'utilisation → Critère de contrôle, exigée dans le
// cahier des charges. Chaque ligne relie un poste à un équipement — jamais
// une durée ou une exigence figée en dur.
model JobRiskProtection {
  id String @id @default(cuid())
  code String @unique
  jobTitle String
  activity String?
  hazard String
  riskDescription String?
  preventionMeasure String?
  epiId String?
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  epcId String?
  epc Epc? @relation(fields:[epcId], references:[id], onDelete:SetNull)
  usageFrequency String?
  controlCriteria String?
  createdAt DateTime @default(now())
}

model DailyHeadcount {
  id String @id @default(cuid())
  date DateTime @unique
  headcount Int
  source String?
  createdAt DateTime @default(now())
}

model SyncItem {
  id String @id @default(cuid())
  clientLocalId String @unique
  entity String
  entityId String?
  operation String
  payload Json
  status SyncStatus @default(PENDING)
  error String?
  createdAt DateTime @default(now())
  syncedAt DateTime?
}

model SafetyEvent {
  id String @id @default(cuid())
  type String
  // Catégorie — configurable, jamais figée : Accident du travail /
  // Incident-presque-accident / Autre selon ce que l'entreprise utilise.
  categorie String?
  title String
  description String?
  occurredAt DateTime
  severity Int @default(1)
  withLostTime Boolean @default(false)
  lostDays Int?
  // Localisation
  siteId String?
  zone String?
  atelier String?
  poste String?
  activite String?
  // Personne concernée — lien vers un employé si applicable, sinon
  // saisie libre (intérimaire, visiteur, sous-traitant...).
  employeeId String?
  personneNom String?
  personneFonction String?
  typePersonnel String?
  // Conséquences
  typeLesion String?
  siegeLesion String?
  consequenceMaterielle String?
  consequenceEnvironnementale String?
  mecanisme String?
  // Pour les incidents/presque-accidents — la question clé pour
  // repérer les signaux faibles avant qu'ils ne deviennent un accident.
  potentielGravite String?
  // Enquête et analyse des causes — 5M (jamais limité à "erreur
  // humaine"), texte libre pour rester adaptable à tout secteur.
  enqueteurId String?
  dateEnquete DateTime?
  methodeAnalyse String?
  causeHumaine String?
  causeMethode String?
  causeMachine String?
  causeMatiere String?
  causeMilieu String?
  causeManagement String?
  causeRacine String?
  // Workflow — jamais de clôture sans passer par les étapes.
  statut String @default("DECLARE")
  dateCloture DateTime?
  // Liens universels vers les modules déjà existants.
  riskId String?
  epiId String?
  epcId String?
  processusId String?
  fournisseurId String?
  nonConformityId String?
  equipmentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  enqueteur User? @relation(fields:[enqueteurId], references:[id], onDelete:SetNull)
  risk Risk? @relation(fields:[riskId], references:[id], onDelete:SetNull)
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  epc Epc? @relation(fields:[epcId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  nonConformity NonConformity? @relation(fields:[nonConformityId], references:[id], onDelete:SetNull)
  equipment Equipment? @relation(fields:[equipmentId], references:[id], onDelete:SetNull)
  actions Action[]
}

// Heures travaillées par période, nécessaires au calcul du Taux de Fréquence
// (TF) et du Taux de Gravité (TG) des accidents du travail :
//   TF = (accidents avec arrêt × 1 000 000) / heures travaillées
//   TG = (journées perdues × 1 000) / heures travaillées
model WorkedHours {
  id String @id @default(cuid())
  code String @unique
  periodStart DateTime
  periodEnd DateTime
  hours Float
  site String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NonConformity {
  id String @id @default(cuid())
  code String @unique
  title String
  description String?
  severity Int @default(1)
  status String @default("OPEN")
  source String?
  // Classification configurable (observation, écart mineur, NC mineure/
  // majeure/critique, danger immédiat, anomalie...) — texte libre plutôt
  // qu'un enum figé, pour rester personnalisable sans toucher au code.
  classification String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())
  qualityControlId String?
  epiId String?
  epcId String?
  processusId String?
  fournisseurId String?
  riskId String?
  equipmentId String?
  // --- Phase 1 : criticité, confinement, étendue ---
  workUnitId String?
  declarantId String?
  responsibleId String?
  gravite Int?
  probabilite Int?
  etendue Int?
  criticiteScore Int?
  criticiteNiveau String?
  quantiteNc Float?
  quantiteControlee Float?
  quantiteBloquee Float?
  quantiteLiberee Float?
  quantiteDetruite Float?
  quantiteReparee Float?
  tauxNc Float?
  dueDate DateTime?
  closedAt DateTime?
  reopenedCount Int @default(0)
  // --- Phase 2 : analyse des causes et vérification d'efficacité ---
  causeRacineIdentifiee Boolean @default(false)
  effectivenessResult String?
  effectivenessCheckedAt DateTime?
  effectivenessNotes String?
  // --- Lien HACCP (additif) : NC générée automatiquement depuis un relevé
  // de surveillance CCP hors limite (voir HaccpService), jamais l'inverse.
  haccpMonitoringRecordId String?
  // --- Lien Veille réglementaire (additif) ---
  regulatoryRequirementId String?
  actions Action[]
  qualityControl QualityControl? @relation(fields:[qualityControlId], references:[id], onDelete:SetNull)
  haccpMonitoringRecord HaccpMonitoringRecord? @relation(fields:[haccpMonitoringRecordId], references:[id], onDelete:SetNull)
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  epc Epc? @relation(fields:[epcId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  risk Risk? @relation(fields:[riskId], references:[id], onDelete:SetNull)
  equipment Equipment? @relation(fields:[equipmentId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  declarant User? @relation("NcDeclarant", fields:[declarantId], references:[id], onDelete:SetNull)
  responsible User? @relation("NcResponsible", fields:[responsibleId], references:[id], onDelete:SetNull)
  auditFindings AuditFinding[]
  reclamations Reclamation[]
  safetyEvents SafetyEvent[]
  containmentActions NcContainmentAction[]
  causes NcCause[]
  costs NcCost[]
  equipmentControls EquipmentControl[]
  equipmentCalibrations EquipmentCalibration[]
  regulatoryRequirement RegulatoryRequirement? @relation(fields:[regulatoryRequirementId], references:[id], onDelete:SetNull)
  @@index([status,occurredAt])
}

// Action de confinement / action immédiate (point 9) — distincte des
// actions correctives/préventives du module Actions, car elle vise à
// sécuriser tout de suite, pas à traiter la cause.
model NcContainmentAction {
  id String @id @default(cuid())
  nonConformityId String
  type String
  description String?
  responsableId String?
  date DateTime @default(now())
  echeance DateTime?
  resultat String?
  cout Float?
  createdAt DateTime @default(now())
  nonConformity NonConformity @relation(fields:[nonConformityId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
}

// Analyse des causes structurée (point 11-12) — chaque ligne est un niveau
// de "Pourquoi", une branche Ishikawa, ou toute autre méthode, avec une
// classification de cause (5M + variantes) et un marqueur "cause racine".
model NcCause {
  id String @id @default(cuid())
  nonConformityId String
  methode String
  niveau String?
  categorie String?
  description String
  type String?
  estRacine Boolean @default(false)
  createdAt DateTime @default(now())
  nonConformity NonConformity @relation(fields:[nonConformityId], references:[id], onDelete:Cascade)
}

// Paramétrage du module NC — seuils de criticité et délai standard,
// modifiables par l'administrateur sans toucher au code.
model NcSettings {
  id String @id @default(cuid())
  seuilModeree Int @default(20)
  seuilMajeure Int @default(50)
  seuilCritique Int @default(75)
  delaiStandardJours Int @default(30)
  updatedAt DateTime @updatedAt
}

// Coût de non-qualité (point 26) — une ligne par poste de coût, jamais un
// seul montant global, pour permettre la ventilation par type et le calcul
// automatique des totaux/moyennes.
model NcCost {
  id String @id @default(cuid())
  nonConformityId String
  type String
  montant Float
  description String?
  createdAt DateTime @default(now())
  nonConformity NonConformity @relation(fields:[nonConformityId], references:[id], onDelete:Cascade)
}

model Action {
  id String @id @default(cuid())
  code String @unique
  title String
  description String?
  status String @default("OPEN")
  priority Int @default(2)
  dueDate DateTime?
  completedAt DateTime?
  responsibleId String?
  nonConformityId String?
  processusId String?
  reclamationId String?
  fournisseurId String?
  safetyEventId String?
  risqueSanitaireId String?
  ergonomieId String?
  environnementAspectId String?
  riskId String?
  auditFindingId String?
  equipmentId String?
  regulatoryRequirementId String?
  objectifQhseId String?
  trainingId String?
  // --- Module Actions CAPA (Phases 1+2), additif ---
  // Distinction volontaire curative/corrective/préventive/amélioration —
  // jamais réduite au seul couple corrective/préventive, pour éviter la
  // confusion classique des systèmes QHSE (cf. point 2 du cahier des charges).
  actionType String?
  criticite String?
  source String?
  workUnitId String?
  parentActionId String?
  avancement Int @default(0)
  dateDebutPrevue DateTime?
  dateDebutReelle DateTime?
  dateValidation DateTime?
  dateCloture DateTime?
  // --- Phase 3 : vérification d'efficacité, prolongation, réouverture ---
  effectivenessResult String?
  effectivenessCheckedAt DateTime?
  effectivenessNotes String?
  reopenedCount Int @default(0)
  responsible User? @relation(fields:[responsibleId], references:[id], onDelete:SetNull)
  nonConformity NonConformity? @relation(fields:[nonConformityId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  reclamation Reclamation? @relation(fields:[reclamationId], references:[id], onDelete:SetNull)
  safetyEvent SafetyEvent? @relation(fields:[safetyEventId], references:[id], onDelete:SetNull)
  risqueSanitaire RisqueSanitaire? @relation(fields:[risqueSanitaireId], references:[id], onDelete:SetNull)
  ergonomie AnalyseErgonomique? @relation(fields:[ergonomieId], references:[id], onDelete:SetNull)
  environnementAspect EnvironnementAspect? @relation(fields:[environnementAspectId], references:[id], onDelete:SetNull)
  risk Risk? @relation(fields:[riskId], references:[id], onDelete:SetNull)
  auditFinding AuditFinding? @relation(fields:[auditFindingId], references:[id], onDelete:SetNull)
  equipment Equipment? @relation(fields:[equipmentId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  parentAction Action? @relation("ActionParent", fields:[parentActionId], references:[id], onDelete:SetNull)
  subActions Action[] @relation("ActionParent")
  causes ActionCause[]
  extensions ActionExtension[]
  links CapaLink[]
  regulatoryRequirement RegulatoryRequirement? @relation(fields:[regulatoryRequirementId], references:[id], onDelete:SetNull)
  objectifQhse ObjectifQhse? @relation(fields:[objectifQhseId], references:[id], onDelete:SetNull)
  training Training? @relation(fields:[trainingId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,dueDate])
}

// Matrice de liaison générique (points 2, 6, 7, 8, 26 du cahier des
// charges) — une seule table de liaison plutôt qu'une table CAPA par
// module. Permet réellement N sources → 1 CAPA et 1 source → N CAPA,
// ce que les colonnes dédiées existantes (nonConformityId, riskId...) ne
// permettent pas seules. Ces colonnes restent utilisées telles quelles
// pour la source principale ; CapaLink complète pour tout le reste.
model CapaLink {
  id String @id @default(cuid())
  actionId String
  sourceModule String
  sourceEntityId String
  relationType String @default("GENEREE_PAR")
  metadata Json?
  createdAt DateTime @default(now())
  createdById String?
  action Action @relation(fields:[actionId], references:[id], onDelete:Cascade)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  @@index([sourceModule,sourceEntityId])
}

// Prolongation d'échéance (point 26) — l'ancienne échéance n'est jamais
// écrasée, seulement remplacée sur l'action avec un historique conservé ici.
model ActionExtension {
  id String @id @default(cuid())
  actionId String
  ancienneEcheance DateTime?
  nouvelleEcheance DateTime
  motif String
  demandeurId String?
  validateurId String?
  createdAt DateTime @default(now())
  action Action @relation(fields:[actionId], references:[id], onDelete:Cascade)
  demandeur User? @relation("ActionExtensionDemandeur", fields:[demandeurId], references:[id], onDelete:SetNull)
  validateur User? @relation("ActionExtensionValidateur", fields:[validateurId], references:[id], onDelete:SetNull)
}

// Analyse des causes d'une action CAPA (point 6) — même structure que pour
// les non-conformités (5 Pourquoi, Ishikawa/5M...), réutilisée à l'identique
// plutôt que dupliquée sous un autre nom.
model ActionCause {
  id String @id @default(cuid())
  actionId String
  methode String
  niveau String?
  categorie String?
  description String
  type String?
  estRacine Boolean @default(false)
  createdAt DateTime @default(now())
  action Action @relation(fields:[actionId], references:[id], onDelete:Cascade)
}

model Site {
  id String @id @default(cuid())
  code String @unique
  name String
  location String?
  active Boolean @default(true)
  lines ProductionLine[]
  qualityControls QualityControl[]
  controlSchedules ControlSchedule[]
  reclamations Reclamation[]
  processus Processus[]
  safetyEvents SafetyEvent[]
  risquesSanitaires RisqueSanitaire[]
  analysesErgonomiques AnalyseErgonomique[]
  environnementAspects EnvironnementAspect[]
  workUnits WorkUnit[]
  documents Document[]
  safetyTalks SafetyTalk[]
  haccpStudies HaccpStudy[]
  equipments Equipment[]
  regulatoryRequirements RegulatoryRequirement[]
  objectifsQhse ObjectifQhse[]
  rapportsQhse RapportQhse[]
  createdAt DateTime @default(now())
}

model ProductionLine {
  id String @id @default(cuid())
  siteId String
  code String @unique
  name String
  area String?
  active Boolean @default(true)
  site Site @relation(fields:[siteId], references:[id], onDelete:Restrict)
  machines Machine[]
  controls QualityControl[]
  controlSchedules ControlSchedule[]
  @@index([siteId])
}

model Machine {
  id String @id @default(cuid())
  lineId String
  code String @unique
  name String
  category String?
  active Boolean @default(true)
  line ProductionLine @relation(fields:[lineId], references:[id], onDelete:Restrict)
  controls QualityControl[]
}

model Product {
  id String @id @default(cuid())
  code String @unique
  name String
  category String?
  active Boolean @default(true)
  formats ProductFormat[]
  controls QualityControl[]
}

model ProductFormat {
  id String @id @default(cuid())
  productId String
  code String
  label String
  volumeMl Int?
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  controls QualityControl[]
  @@unique([productId,code])
}

model Shift {
  id String @id @default(cuid())
  code String @unique
  name String
  startTime String?
  endTime String?
  active Boolean @default(true)
  controls QualityControl[]
}

model QualityControl {
  id String @id @default(cuid())
  code String @unique
  siteId String?
  lineId String?
  machineId String?
  productId String?
  formatId String?
  shiftId String?
  line String?
  product String?
  format String?
  lotNumber String?
  shift String?
  controlDate DateTime @default(now())
  status QualityControlStatus @default(DRAFT)
  result String?
  notes String?
  latitude Float?
  longitude Float?
  gpsAccuracy Float?
  startedAt DateTime?
  submittedAt DateTime?
  createdById String?
  templateId String?
  // Le même moteur de contrôle sert désormais à tous les modules — ce
  // champ indique juste dans quel domaine ce contrôle-ci a été réalisé,
  // sans jamais renommer ni dupliquer l'entité elle-même.
  domain String @default("QUALITE")
  typeId String?
  // Liens universels vers les autres modules déjà existants — un
  // contrôle peut porter sur un EPI, un EPC, un risque, un fournisseur
  // ou un employé, en plus des liens qualité déjà en place.
  epiId String?
  epcId String?
  riskId String?
  fournisseurId String?
  employeeId String?
  processusId String?
  // Taux de conformité calculé à la soumission — les points marqués non
  // applicables sont exclus du dénominateur, jamais comptés comme échec.
  conformityRate Float?
  // Décision finale — plus riche que le simple statut technique
  // COMPLIANT/NON_COMPLIANT : Conforme, Conforme sous réserve, Refusé,
  // Bloqué, Libéré, À recontrôler... configurable, jamais figée en dur.
  finalDecision String?
  // Échantillonnage (contrôles produit) — tout optionnel, sans incidence
  // sur les contrôles qui n'en ont pas besoin.
  lotSize Int?
  sampleSize Int?
  samplingMethod String?
  defectRate Float?
  acceptanceThreshold Float?
  rejectionThreshold Float?
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  productionLine ProductionLine? @relation(fields:[lineId], references:[id], onDelete:SetNull)
  machine Machine? @relation(fields:[machineId], references:[id], onDelete:SetNull)
  productRef Product? @relation(fields:[productId], references:[id], onDelete:SetNull)
  productFormat ProductFormat? @relation(fields:[formatId], references:[id], onDelete:SetNull)
  shiftRef Shift? @relation(fields:[shiftId], references:[id], onDelete:SetNull)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  template ControlTemplate? @relation(fields:[templateId], references:[id], onDelete:SetNull)
  type ControlType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  epc Epc? @relation(fields:[epcId], references:[id], onDelete:SetNull)
  risk Risk? @relation(fields:[riskId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  nonConformities NonConformity[]
  results ControlResult[]
  attachments QualityControlAttachment[]
  signatures QualityControlSignature[]
  @@index([controlDate])
  @@index([status])
  @@index([lineId,controlDate])
  @@index([productId,lotNumber])
  @@index([domain,controlDate])
}

// Catalogue des types de contrôle (contrôle qualité, réception, machine,
// hygiène, EPI/EPC...) — géré par l'administrateur, jamais une liste
// figée en dur. Un modèle de contrôle (ControlTemplate) appartient à un
// type ; un contrôle peut aussi référencer directement son type.
model ControlType {
  id String @id @default(cuid())
  code String @unique
  name String
  domain String @default("QUALITE")
  description String?
  active Boolean @default(true)
  templates ControlTemplate[]
  controls QualityControl[]
  schedules ControlSchedule[]
  createdAt DateTime @default(now())
}

// Planification des contrôles récurrents (section 9 du cahier des
// charges) : quotidien, hebdomadaire, mensuel, trimestriel, semestriel,
// annuel ou intervalle personnalisé. La génération du contrôle concret
// reste une action explicite (bouton "Générer maintenant") plutôt qu'une
// tâche automatique en arrière-plan — plus sûr, rien ne peut se
// déclencher tout seul de façon inattendue.
model ControlSchedule {
  id String @id @default(cuid())
  code String @unique
  name String
  domain String @default("QUALITE")
  typeId String?
  templateId String?
  frequency String
  intervalDays Int?
  assignedToId String?
  nextDueDate DateTime
  lastGeneratedAt DateTime?
  active Boolean @default(true)
  siteId String?
  lineId String?
  createdAt DateTime @default(now())
  type ControlType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  template ControlTemplate? @relation(fields:[templateId], references:[id], onDelete:SetNull)
  assignedTo User? @relation(fields:[assignedToId], references:[id], onDelete:SetNull)
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  productionLine ProductionLine? @relation(fields:[lineId], references:[id], onDelete:SetNull)
  @@index([nextDueDate,active])
}

model ControlTemplate {
  id String @id @default(cuid())
  code String @unique
  name String
  active Boolean @default(true)
  domain String @default("QUALITE")
  typeId String?
  type ControlType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  points ControlPoint[]
  controls QualityControl[]
  schedules ControlSchedule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ControlPoint {
  id String @id @default(cuid())
  templateId String
  code String
  label String
  type ControlValueType
  required Boolean @default(false)
  critical Boolean @default(false)
  minValue Float?
  maxValue Float?
  choices Json?
  unit String?
  order Int @default(0)
  template ControlTemplate @relation(fields:[templateId], references:[id], onDelete:Cascade)
  results ControlResult[]
  @@unique([templateId,code])
  @@index([templateId,order])
}

model ControlResult {
  id String @id @default(cuid())
  controlId String
  pointId String
  value Json?
  compliant Boolean?
  // Un point marqué non applicable ne compte ni comme conforme ni comme
  // non conforme — il doit être exclu du dénominateur du taux de
  // conformité, jamais traité comme un échec silencieux.
  notApplicable Boolean @default(false)
  comment String?
  photoRequired Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  control QualityControl @relation(fields:[controlId], references:[id], onDelete:Cascade)
  point ControlPoint @relation(fields:[pointId], references:[id], onDelete:Restrict)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  @@unique([controlId,pointId])
}

model QualityControlAttachment {
  id String @id @default(cuid())
  controlId String
  attachmentId String
  control QualityControl @relation(fields:[controlId], references:[id], onDelete:Cascade)
  attachment Attachment @relation(fields:[attachmentId], references:[id], onDelete:Cascade)
  @@unique([controlId,attachmentId])
}

model QualityControlSignature {
  id String @id @default(cuid())
  controlId String
  userId String?
  type SignatureType
  signatureData String
  signedAt DateTime @default(now())
  control QualityControl @relation(fields:[controlId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([controlId])
}

model Risk {
  id String @id @default(cuid())
  code String @unique
  hazard String
  activity String?
  severity Int
  probability Int
  control Int @default(1)
  score Int
  status String @default("ACTIVE")
  measures String?
  reviewedAt DateTime?
  processusId String?
  fournisseurId String?
  // --- Registre des risques : moteur d'évaluation étendu (additif, aucun
  // champ existant modifié ou supprimé) ---
  workUnitId String?
  categoryId String?
  hazardousSituation String?
  hazardousEvent String?
  potentialDamage String?
  exposedPersons String?
  exposedPersonCount Int?
  // GP = Gravité×Probabilité (par défaut), GPE = Gravité×Probabilité×Exposition
  method String @default("GP")
  exposure Int @default(1)
  grossScore Int?
  grossLevel String?
  residualSeverity Int?
  residualProbability Int?
  residualExposure Int?
  residualScore Int?
  residualLevel String?
  controlStatus String @default("NON_MAITRISE")
  equipmentId String?
  nextReviewDate DateTime?
  reviewPeriodDays Int @default(365)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  qualityControls QualityControl[]
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  safetyEvents SafetyEvent[]
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  category RiskCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  equipment Equipment? @relation(fields:[equipmentId], references:[id], onDelete:SetNull)
  actions Action[]
  riskMeasures RiskMeasure[]
  evaluations RiskEvaluation[]
  nonConformities NonConformity[]
  auditFindings AuditFinding[]
  environnementAspects EnvironnementAspect[]
  regulatoryRequirementLinks RegulatoryRequirementRisk[]
  regulatoryReevaluationRequests RegulatoryRiskReevaluationRequest[]
  objectifLinks ObjectifRisk[]
  @@index([status,score])
}

// Unité de travail — brique manquante pour situer un risque (département/
// service/poste) indépendamment du Processus ou du Fournisseur, réutilisable
// par tout futur module qui aura besoin de la même granularité.
model WorkUnit {
  id String @id @default(cuid())
  code String @unique
  name String
  siteId String?
  department String?
  service String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  risks Risk[]
  audits QhseAudit[]
  auditPrograms AuditProgram[]
  nonConformities NonConformity[]
  actions Action[]
  documents Document[]
  safetyTalks SafetyTalk[]
  equipments Equipment[]
  regulatoryRequirements RegulatoryRequirement[]
  objectifsQhse ObjectifQhse[]
}

// Bibliothèque de catégories de risques configurable par l'administrateur —
// jamais une liste figée dans le code (mécanique, électrique, chimique,
// ergonomique, incendie, psychosocial, etc. restent des données).
model RiskCategory {
  id String @id @default(cuid())
  code String @unique
  label String
  order Int @default(0)
  active Boolean @default(true)
  risks Risk[]
}

// Mesure de prévention existante rattachée à un risque, classée selon la
// hiérarchie de prévention (texte libre pour rester adaptable à tout
// secteur : suppression, substitution, protection collective, technique,
// organisationnelle, procédure, formation, signalisation, EPI...).
model RiskMeasure {
  id String @id @default(cuid())
  riskId String
  description String
  type String
  responsableId String?
  datePrise DateTime?
  efficacite Int @default(1)
  justificatif String?
  epiId String?
  trainingId String?
  createdAt DateTime @default(now())
  risk Risk @relation(fields:[riskId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  epi Epi? @relation(fields:[epiId], references:[id], onDelete:SetNull)
  training Training? @relation(fields:[trainingId], references:[id], onDelete:SetNull)
}

// Historique des évaluations successives d'un risque — sans cette table,
// aucune courbe d'évolution brut → résiduel → réévaluation n'est possible,
// exactement comme IndicateurMesure sert d'historique à IndicateurQualite.
model RiskEvaluation {
  id String @id @default(cuid())
  riskId String
  evaluatedAt DateTime @default(now())
  severity Int
  probability Int
  exposure Int @default(1)
  grossScore Int
  grossLevel String
  residualSeverity Int?
  residualProbability Int?
  residualExposure Int?
  residualScore Int?
  residualLevel String?
  note String?
  evaluatedById String?
  risk Risk @relation(fields:[riskId], references:[id], onDelete:Cascade)
  evaluatedBy User? @relation(fields:[evaluatedById], references:[id], onDelete:SetNull)
}

// Paramétrage du Registre des risques — une seule ligne en base. Permet à
// l'administrateur de changer la méthode, les seuils et la périodicité de
// réévaluation sans toucher au code, pour rester générique à tout secteur.
model RiskSettings {
  id String @id @default(cuid())
  method String @default("GP")
  seuilModere Int @default(5)
  seuilEleve Int @default(10)
  seuilCritique Int @default(15)
  seuilActionRequise Int @default(10)
  reviewPeriodDays Int @default(365)
  updatedAt DateTime @updatedAt
}

// ============================================================================
// Module HACCP — remplace intégralement l'ancien HaccpRecord (CRUD plat sans
// workflow). Modélise l'étude HACCP complète (équipe, diagramme de flux,
// analyse des dangers, détermination des CCP/CP, surveillance, PRP,
// révisions) avec le même principe directeur que le reste de l'application :
// la chaîne HACCP → Non-conformité → Action CAPA → Vérification d'efficacité
// est proposée automatiquement par le système mais jamais imposée sans
// validation humaine (voir HaccpService, même pattern que
// SafetyTalkFeedback.transformFeedback et le moteur de recommandation du
// module Quart d'heure sécurité).
// ============================================================================

model HaccpStudy {
  id String @id @default(cuid())
  code String @unique
  name String
  siteId String?
  activite String?
  atelier String?
  ligne String?
  produit String?
  categorieProduit String?
  descriptionProduit String?
  destination String?
  consommateurCible String?
  conditionsStockage String?
  dureeConservation String?
  modeDistribution String?
  responsableId String?
  dateCreation DateTime @default(now())
  dateValidation DateTime?
  dateDerniereRevision DateTime?
  prochaineRevision DateTime?
  version String @default("1.0")
  // BROUILLON / EN_VALIDATION / VALIDE / SUSPENDU / ARCHIVE
  status String @default("BROUILLON")
  createdAt DateTime @default(now())
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  team HaccpTeamMember[]
  steps HaccpProcessStep[]
  hazards HaccpHazard[]
  ccps HaccpCcp[]
  prps HaccpPrp[]
  revisions HaccpRevision[]
}

// Équipe HACCP — composition, compétences et formation, exigées par le
// référentiel (constitution de l'équipe pluridisciplinaire).
model HaccpTeamMember {
  id String @id @default(cuid())
  studyId String
  employeeId String?
  userId String?
  fonction String?
  service String?
  competence String?
  formationHaccp Boolean @default(false)
  dateFormation DateTime?
  experience String?
  roleEtude String?
  responsabilites String?
  statut String @default("ACTIF")
  createdAt DateTime @default(now())
  study HaccpStudy @relation(fields:[studyId], references:[id], onDelete:Cascade)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
}

// Diagramme de flux — une ligne par étape du procédé, dans l'ordre "ordre".
model HaccpProcessStep {
  id String @id @default(cuid())
  studyId String
  numero Int
  nom String
  description String?
  responsableId String?
  zone String?
  equipement String?
  matiereEntrante String?
  matiereSortante String?
  parametresControles String?
  ordre Int @default(0)
  createdAt DateTime @default(now())
  study HaccpStudy @relation(fields:[studyId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  hazards HaccpHazard[]
  ccps HaccpCcp[]
}

// Analyse des dangers par étape — type biologique/chimique/physique/
// allergène/autre, avec cotation gravité×probabilité×maîtrise et niveau de
// risque calculé (voir HaccpService.calculerNiveauRisque).
model HaccpHazard {
  id String @id @default(cuid())
  studyId String
  stepId String
  type String
  libelle String
  origine String?
  gravite Int?
  probabilite Int?
  niveauMaitrise Int?
  // FAIBLE / MODERE / SIGNIFICATIF / CRITIQUE — recalculé automatiquement.
  niveauRisque String?
  justification String?
  mesuresExistantes String?
  mesuresSupplementaires String?
  createdAt DateTime @default(now())
  study HaccpStudy @relation(fields:[studyId], references:[id], onDelete:Cascade)
  step HaccpProcessStep @relation(fields:[stepId], references:[id], onDelete:Cascade)
  ccps HaccpCcp[]
}

// Fiche CCP/CP — fusionne volontairement la détermination (arbre de
// décision) et la fiche de surveillance détaillée pour rester réalisable,
// plutôt que deux entités séparées peu exploitables en pratique.
model HaccpCcp {
  id String @id @default(cuid())
  studyId String
  hazardId String
  stepId String
  // Ex. CCP-01 / CP-01 — généré automatiquement (voir HaccpService.genererReference).
  reference String @unique
  // CCP ou CP (point de vigilance/point de contrôle)
  type String @default("CCP")
  arbreDecisionReponses Json?
  dangerMaitrise String?
  causeDanger String?
  mesureMaitrise String?
  limiteCritique String?
  critereAcceptation String?
  parametre String?
  unite String?
  methode String?
  instrument String?
  frequence String?
  responsableId String?
  enregistrementAssocie String?
  actionImmediate String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  study HaccpStudy @relation(fields:[studyId], references:[id], onDelete:Cascade)
  hazard HaccpHazard @relation(fields:[hazardId], references:[id], onDelete:Cascade)
  step HaccpProcessStep @relation(fields:[stepId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  monitoringRecords HaccpMonitoringRecord[]
}

// Surveillance/contrôle d'un CCP — l'écran de saisie rapide terrain. Un
// résultat hors limite (conforme=false) déclenche automatiquement la
// création d'une NonConformity (jamais d'une Action CAPA, qui reste un acte
// humain explicite) — voir HaccpService.enregistrerNonConformite.
model HaccpMonitoringRecord {
  id String @id @default(cuid())
  ccpId String
  // Copie dénormalisée de l'étude pour filtrer/lister sans jointure — le CCP
  // reste la source de vérité (voir ccp.studyId).
  studyId String
  datePrevue DateTime?
  dateRealisee DateTime?
  valeur Float?
  valeurTexte String?
  conforme Boolean?
  // A_REALISER / EN_RETARD / REALISE / CONFORME / NON_CONFORME / ANNULE / JUSTIFIE
  statut String @default("A_REALISER")
  lotNumero String?
  responsableId String?
  commentaire String?
  photoUrl String?
  signature String?
  // Rempli automatiquement quand la NC est créée depuis ce relevé.
  nonConformityId String?
  createdAt DateTime @default(now())
  ccp HaccpCcp @relation(fields:[ccpId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  nonConformities NonConformity[]
}

// Programmes prérequis / bonnes pratiques d'hygiène — un PRP peut être
// transversal (studyId nul) ou rattaché à une étude précise.
model HaccpPrp {
  id String @id @default(cuid())
  studyId String?
  type String
  libelle String
  description String?
  frequence String?
  responsableId String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  study HaccpStudy? @relation(fields:[studyId], references:[id], onDelete:SetNull)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
}

// Historique des révisions du plan HACCP — déclenchées par un nouveau
// produit, une modification de recette, un changement fournisseur, etc.
model HaccpRevision {
  id String @id @default(cuid())
  studyId String
  version String
  date DateTime @default(now())
  declencheur String
  description String?
  responsableId String?
  createdAt DateTime @default(now())
  study HaccpStudy @relation(fields:[studyId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
}

model QhseAudit {
  id String @id @default(cuid())
  code String @unique
  title String
  reference String?
  auditDate DateTime
  auditorId String?
  status String @default("PLANNED")
  score Float?
  findings Json?
  processusId String?
  fournisseurId String?
  // --- Module Audits : enrichissement additif (Phase 1) ---
  typeId String?
  referentialId String?
  workUnitId String?
  responsableAuditeId String?
  scope String?
  objectif String?
  auditTeamIds Json?
  dureePrevueHeures Float?
  priorite String @default("NORMALE")
  scoreMax Float?
  tauxConformite Float?
  // --- Phase 2 : check-list et moteur de notation ---
  checklistId String?
  scoringMethod String @default("CONFORME_NON_CONFORME")
  scoreObtenu Float?
  scorePondere Float?
  createdAt DateTime @default(now())
  auditor User? @relation("AuditAuditor", fields:[auditorId], references:[id], onDelete:SetNull)
  responsableAudite User? @relation("AuditResponsable", fields:[responsableAuditeId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  type AuditType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  referential AuditReferential? @relation(fields:[referentialId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  checklist AuditChecklist? @relation(fields:[checklistId], references:[id], onDelete:SetNull)
  auditFindings AuditFinding[]
  programs AuditProgram[]
  responses AuditQuestionResponse[]
  signatures AuditSignature[]
}

// Bibliothèque de types d'audit configurable — jamais une liste figée
// dans le code (interne, externe, fournisseur, HACCP, énergétique...).
model AuditType {
  id String @id @default(cuid())
  code String @unique
  label String
  order Int @default(0)
  active Boolean @default(true)
  audits QhseAudit[]
  programs AuditProgram[]
  checklists AuditChecklist[]
}

// Référentiel d'audit (ISO 9001, HACCP, exigences client...) — chapitres et
// exigences détaillés dans AuditReferentialItem, réutilisables par les
// check-lists de la Phase 2.
model AuditReferential {
  id String @id @default(cuid())
  code String @unique
  label String
  description String?
  active Boolean @default(true)
  items AuditReferentialItem[]
  audits QhseAudit[]
  programs AuditProgram[]
  checklists AuditChecklist[]
}

model AuditReferentialItem {
  id String @id @default(cuid())
  referentialId String
  chapitre String?
  article String?
  exigence String
  order Int @default(0)
  referential AuditReferential @relation(fields:[referentialId], references:[id], onDelete:Cascade)
  checklistItems AuditChecklistItem[]
}

// Programme annuel/périodique — une ligne planifiée qui peut ensuite générer
// l'audit réel (QhseAudit) sans ressaisie, comme un risque généré depuis un
// accident ou une non-conformité.
model AuditProgram {
  id String @id @default(cuid())
  code String @unique
  title String
  year Int
  periode String?
  typeId String?
  referentialId String?
  workUnitId String?
  processusId String?
  auditeurPrincipalId String?
  datePrevue DateTime?
  dureePrevueHeures Float?
  priorite String @default("NORMALE")
  frequence String?
  statut String @default("PLANIFIE")
  commentaires String?
  auditId String?
  createdAt DateTime @default(now())
  type AuditType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  referential AuditReferential? @relation(fields:[referentialId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  auditeurPrincipal User? @relation(fields:[auditeurPrincipalId], references:[id], onDelete:SetNull)
  audit QhseAudit? @relation(fields:[auditId], references:[id], onDelete:SetNull)
}

// Modèle de check-list réutilisable (point 6) — une fois créée, elle peut
// être appliquée à n'importe quel audit du même type/référentiel.
model AuditChecklist {
  id String @id @default(cuid())
  code String @unique
  title String
  referentialId String?
  typeId String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  referential AuditReferential? @relation(fields:[referentialId], references:[id], onDelete:SetNull)
  type AuditType? @relation(fields:[typeId], references:[id], onDelete:SetNull)
  items AuditChecklistItem[]
  audits QhseAudit[]
}

model AuditChecklistItem {
  id String @id @default(cuid())
  checklistId String
  chapitre String?
  numero String?
  question String
  critereAttendu String?
  preuveRecherchee String?
  criticite String @default("FAIBLE")
  poids Float @default(1)
  referentialItemId String?
  order Int @default(0)
  checklist AuditChecklist @relation(fields:[checklistId], references:[id], onDelete:Cascade)
  referentialItem AuditReferentialItem? @relation(fields:[referentialItemId], references:[id], onDelete:SetNull)
  responses AuditQuestionResponse[]
  findings AuditFinding[]
}

// Réponse à une question de check-list pour un audit donné — une ligne par
// couple (audit, question), jamais dupliquée grâce à la contrainte unique.
model AuditQuestionResponse {
  id String @id @default(cuid())
  auditId String
  checklistItemId String
  resultat String @default("NON_EVALUE")
  score Float?
  commentaire String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audit QhseAudit @relation(fields:[auditId], references:[id], onDelete:Cascade)
  checklistItem AuditChecklistItem @relation(fields:[checklistItemId], references:[id], onDelete:Cascade)
  @@unique([auditId, checklistItemId])
}

// Profil auditeur (point 14) — un enregistrement optionnel par utilisateur,
// créé seulement quand quelqu'un est réellement désigné comme auditeur.
model AuditorProfile {
  id String @id @default(cuid())
  userId String @unique
  competence String?
  domainesExpertise Json?
  formation String?
  experienceAnnees Int?
  disponible Boolean @default(true)
  habilitation String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}

// Signature électronique (point 18) — une ligne par rôle attendu sur
// l'audit (auditeur, responsable audité, responsable QHSE, validateur).
model AuditSignature {
  id String @id @default(cuid())
  auditId String
  role String
  signataireId String?
  signedAt DateTime?
  statut String @default("EN_ATTENTE")
  audit QhseAudit @relation(fields:[auditId], references:[id], onDelete:Cascade)
  signataire User? @relation(fields:[signataireId], references:[id], onDelete:SetNull)
}

// Constat d'audit structuré — remplace le champ "findings" en texte
// libre jamais exploité. Un constat critique peut générer automatiquement
// une non-conformité et une action, exactement comme un point de
// contrôle critique le fait déjà dans le moteur de contrôle universel.
model AuditFinding {
  id String @id @default(cuid())
  auditId String
  description String
  classification String?
  criticite String?
  critical Boolean @default(false)
  status String @default("OPEN")
  closedAt DateTime?
  nonConformityId String?
  riskId String?
  checklistItemId String?
  preuveObjective String?
  zone String?
  responsableId String?
  delai DateTime?
  createdAt DateTime @default(now())
  audit QhseAudit @relation(fields:[auditId], references:[id], onDelete:Cascade)
  nonConformity NonConformity? @relation(fields:[nonConformityId], references:[id], onDelete:SetNull)
  risk Risk? @relation(fields:[riskId], references:[id], onDelete:SetNull)
  checklistItem AuditChecklistItem? @relation(fields:[checklistItemId], references:[id], onDelete:SetNull)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  actions Action[]
}

model EnvironmentRecord {
  id String @id @default(cuid())
  code String @unique
  type String
  categorie String?
  sousCategorie String?
  value Float?
  unit String?
  site String?
  processusId String?
  seuilReglementaire Float?
  conforme Boolean?
  cout Float?
  modeTraitement String?
  destination String?
  recordedAt DateTime @default(now())
  notes String?
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
}

// Aspects & impacts environnementaux — la criticité se recalcule à
// chaque écriture, jamais ressaisie séparément par l'utilisateur.
// Méthode de cotation documentée en clair, jamais un calcul caché.
model EnvironnementAspect {
  id String @id @default(cuid())
  code String @unique
  siteId String?
  processusId String?
  activite String?
  aspect String
  source String?
  impact String?
  milieu String?
  situation String @default("NORMALE")
  frequence Int @default(1)
  gravite Int @default(1)
  probabilite Int @default(1)
  maitrise Int @default(1)
  criticite Int @default(1)
  significatif Boolean @default(false)
  mesuresMaitrise String?
  responsableId String?
  echeance DateTime?
  statut String @default("ACTIVE")
  riskId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  risk Risk? @relation(fields:[riskId], references:[id], onDelete:SetNull)
  actions Action[]
}

// Produits chimiques et substances à impact environnemental — la
// classification et les seuils restent du texte libre pour rester
// utilisables dans tout secteur, jamais une nomenclature figée.
model ProduitChimique {
  id String @id @default(cuid())
  code String @unique
  nom String
  reference String?
  fournisseurId String?
  quantiteStockee Float?
  quantiteConsommee Float?
  unite String?
  classification String?
  dangerEnvironnemental String?
  zoneStockage String?
  retention Boolean @default(false)
  fdsDisponible Boolean @default(false)
  dateControle DateTime?
  dateExpiration DateTime?
  seuilAlerteStock Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
}

// === MODULE FORMATION — Phase 1 : fondations. Distinction volontaire
// INDUCTION (droit d'entree, accueil securite) / FORMATION (acquisition et
// validation d'une competence), champs de planification, cout et lien
// competence/reglementaire, additif — aucun champ existant modifie.
model Training {
  id String @id @default(cuid())
  code String @unique
  title String
  trainer String?
  scheduledAt DateTime
  durationHours Float?
  status String @default("PLANNED")
  participants Json?
  expiryAt DateTime?
  processusId String?
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  riskMeasures RiskMeasure[]
  // --- Phase 1 FORMATION ---
  type String @default("FORMATION") // INDUCTION | FORMATION
  categoryId String?
  category TrainingCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  obligatoire Boolean @default(false)
  domaine String?
  publicCible String?
  objectif String?
  organisme String?
  interneExterne String @default("INTERNE")
  referenceReglementaire String?
  competenceVisee String?
  coutPrevu Float?
  coutReel Float?
  budgetAlloue Float?
  priorite String?
  motifBesoin String?
  periodiciteMois Int?
  recyclageNecessaire Boolean @default(false)
  service String?
  evaluationType String?
  delaiEvaluationEfficaciteJours Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participantsList TrainingParticipant[]
  habilitationsDelivrees Habilitation[]
  actions Action[]
  competencesAssociees EmployeeCompetence[]
  besoinsTransformes BesoinFormation[]
  evaluationsEfficacite TrainingEfficaciteEvaluation[]
}

// Catalogue des categories/domaines de formation — configurable par
// l'administrateur (INDUCTION, SST, HABILITATION, SENSIBILISATION...),
// jamais une liste figee dans le code.
model TrainingCategory {
  id String @id @default(cuid())
  code String @unique
  label String
  groupe String?
  order Int @default(0)
  active Boolean @default(true)
  trainings Training[]
}

// Participation individuelle a une formation — table de liaison structuree
// (plutot que le seul champ participants Json existant, conserve pour
// compatibilite) : c'est elle qui permet de repondre "qui est forme ?" par
// collaborateur et d'alimenter les taux de participation/reussite.
model TrainingParticipant {
  id String @id @default(cuid())
  trainingId String
  employeeId String
  present Boolean?
  score Float?
  seuilReussite Float?
  resultat String? // REUSSI | A_RENFORCER | ECHEC | NON_EVALUE
  commentaire String?
  // --- Phase 3 : preuve de presence par signature electronique, meme
  // principe que EpiAssignment (image PNG en base64, jamais un simple
  // champ texte "signe par") ---
  employeeSignature String?
  responsableSignature String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  training Training @relation(fields:[trainingId], references:[id], onDelete:Cascade)
  employee Employee @relation(fields:[employeeId], references:[id], onDelete:Cascade)
  @@unique([trainingId,employeeId])
}

// Catalogue des types d'habilitation/certification — configurable,
// jamais limite aux exemples du cahier des charges (SST, electrique,
// hauteur, engins, pont roulant, espaces confines, HACCP...).
model HabilitationCategory {
  id String @id @default(cuid())
  code String @unique
  label String
  dureeValiditeMois Int?
  order Int @default(0)
  active Boolean @default(true)
  habilitations Habilitation[]
}

// Registre des habilitations/certifications par collaborateur. Statut
// calcule (jamais fabrique) a partir de dateExpiration et des seuils
// configures dans TrainingSettings : VALIDE / EXPIRE_BIENTOT /
// A_RENOUVELER / EXPIREE / SUSPENDUE / EN_ATTENTE.
model Habilitation {
  id String @id @default(cuid())
  code String @unique
  employeeId String
  categoryId String?
  intitule String
  organisme String?
  numeroDocument String?
  dateObtention DateTime?
  dateExpiration DateTime?
  statut String @default("VALIDE")
  trainingId String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields:[employeeId], references:[id], onDelete:Cascade)
  category HabilitationCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  training Training? @relation(fields:[trainingId], references:[id], onDelete:SetNull)
  competencesAssociees EmployeeCompetence[]
}

// Parametrage global du module FORMATION — seuils d'alerte avant
// expiration des habilitations et poids dans le score QHSE global,
// jamais codes en dur (meme principe que EquipmentSettings).
model TrainingSettings {
  id String @id @default(cuid())
  alerteJ90 Boolean @default(true)
  alerteJ60 Boolean @default(true)
  alerteJ30 Boolean @default(true)
  alerteJ15 Boolean @default(false)
  ponderationScoreGlobal Float @default(10)
  updatedAt DateTime @updatedAt
}

// === MODULE FORMATION — Phase 2 : matrice des competences + moteur de
// detection des besoins. Niveaux configurables (jamais fige en dur) : un
// niveau n'est qu'un code + un ordre, l'ecart requis/actuel se calcule a
// la lecture par comparaison des ordres (jamais stocke, pour ne jamais
// devenir faux si l'administrateur reordonne les niveaux plus tard).
model CompetenceNiveau {
  id String @id @default(cuid())
  code String @unique
  label String
  ordre Int
  active Boolean @default(true)
  competencesRequises EmployeeCompetence[] @relation("NiveauRequis")
  competencesActuelles EmployeeCompetence[] @relation("NiveauActuel")
}

// Catalogue des competences — configurable, jamais limite aux exemples du
// cahier des charges.
model Competence {
  id String @id @default(cuid())
  code String @unique
  label String
  domaine String?
  order Int @default(0)
  active Boolean @default(true)
  employeeCompetences EmployeeCompetence[]
}

// Matrice Collaborateur x Poste x Competence x Niveau requis x Niveau
// actuel. C'est elle qui permet de repondre "qui presente un ecart ?" et
// alimente le moteur de detection (ECART_COMPETENCE).
model EmployeeCompetence {
  id String @id @default(cuid())
  employeeId String
  competenceId String
  poste String?
  niveauRequisId String?
  niveauActuelId String?
  dateEvaluation DateTime?
  formationAssocieeId String?
  habilitationAssocieeId String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee @relation(fields:[employeeId], references:[id], onDelete:Cascade)
  competence Competence @relation(fields:[competenceId], references:[id], onDelete:Cascade)
  niveauRequis CompetenceNiveau? @relation("NiveauRequis", fields:[niveauRequisId], references:[id], onDelete:SetNull)
  niveauActuel CompetenceNiveau? @relation("NiveauActuel", fields:[niveauActuelId], references:[id], onDelete:SetNull)
  formationAssociee Training? @relation(fields:[formationAssocieeId], references:[id], onDelete:SetNull)
  habilitationAssociee Habilitation? @relation(fields:[habilitationAssocieeId], references:[id], onDelete:SetNull)
  @@unique([employeeId,competenceId])
}

// Besoin de formation propose par le moteur de detection a partir des
// autres modules (NC recurrente, accident, risque eleve, habilitation
// expiree, ecart de competence). Reste a l'etat PROPOSE tant qu'un humain
// (Responsable QHSE) ne l'a pas valide ou rejete — jamais de formation
// obligatoire creee automatiquement sans decision humaine (point 17 du
// cahier des charges). sourceKey rend la detection idempotente : une
// meme cause reelle ne genere jamais deux propositions.
model BesoinFormation {
  id String @id @default(cuid())
  code String @unique
  sourceModule String
  sourceKey String @unique
  sourceEntityId String?
  titre String
  description String?
  competenceVisee String?
  employeeId String?
  posteConcerne String?
  priorite String @default("MOYENNE")
  statut String @default("PROPOSE")
  motif String?
  trainingId String?
  traiteParId String?
  traiteLe DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  training Training? @relation(fields:[trainingId], references:[id], onDelete:SetNull)
  traitePar User? @relation(fields:[traiteParId], references:[id], onDelete:SetNull)
  efficaciteOrigine TrainingEfficaciteEvaluation[]
}

// === MODULE FORMATION — Phase 3 : evaluation de l'efficacite a froid.
// Realisee un delai configurable apres la formation (30/60/90 jours ou
// personnalise). Si jugee inefficace, propose automatiquement (comme le
// moteur de detection de la phase 2, jamais sans le meme garde-fou) un
// nouveau besoin de formation — jamais une formation recreee directement.
model TrainingEfficaciteEvaluation {
  id String @id @default(cuid())
  code String @unique
  trainingId String
  employeeId String?
  delaiJours Int
  dateEvaluation DateTime @default(now())
  niveauEfficacite String @default("NON_EVALUEE")
  applicationConnaissances Boolean?
  respectProcedures Boolean?
  changementComportement Boolean?
  autonomie Boolean?
  reductionErreurs Boolean?
  reductionNc Boolean?
  reductionIncidents Boolean?
  commentaire String?
  evaluateurId String?
  besoinGenereId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  training Training @relation(fields:[trainingId], references:[id], onDelete:Cascade)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  evaluateur User? @relation(fields:[evaluateurId], references:[id], onDelete:SetNull)
  besoinGenere BesoinFormation? @relation(fields:[besoinGenereId], references:[id], onDelete:SetNull)
}

// Catalogue de catégories d'équipements — configurable par l'administrateur,
// jamais une liste figée dans le code, pour rester adaptable à tout secteur
// (production, levage/manutention, électrique, incendie/sécurité, appareils
// sous pression, instruments de mesure, véhicules, installations techniques...).
model EquipmentCategory {
  id String @id @default(cuid())
  code String @unique
  label String
  groupe String?
  order Int @default(0)
  active Boolean @default(true)
  equipments Equipment[]
}

// Paramétrage global du module Équipements — seuils de criticité, cadence
// d'alerte réglementaire (J-90/60/30/7) et pondération du score équipements
// dans le score QHSE global : jamais codés en dur (cf. exigence de ne pas
// imposer de fausses obligations universelles), modifiables par l'admin.
model EquipmentSettings {
  id String @id @default(cuid())
  seuilCriticiteModere Int @default(30)
  seuilCriticiteEleve Int @default(60)
  seuilCriticiteCritique Int @default(85)
  alerteJ90 Boolean @default(true)
  alerteJ60 Boolean @default(true)
  alerteJ30 Boolean @default(true)
  alerteJ7 Boolean @default(true)
  ponderationScoreGlobal Float @default(10)
  updatedAt DateTime @updatedAt
}

// === MODULE ÉQUIPEMENTS — Phase 1 : fondations, criticité, chaîne
// Équipement -> Risque -> Contrôle -> NC -> CAPA (additif, aucun champ
// existant modifié ou supprimé) ===
model Equipment {
  id String @id @default(cuid())
  code String @unique
  name String
  category String?
  location String?
  status String @default("ACTIVE")
  lastInspectionAt DateTime?
  nextInspectionAt DateTime?
  notes String?
  // --- Identification étendue ---
  categoryId String?
  type String?
  sousType String?
  marque String?
  modele String?
  numeroSerie String?
  referenceFabricant String?
  anneeFabrication Int?
  dateAcquisition DateTime?
  dateMiseEnService DateTime?
  fournisseurId String?
  constructeur String?
  // --- Localisation ---
  siteId String?
  workUnitId String?
  batiment String?
  zone String?
  // --- Utilisation / responsabilité ---
  responsableId String?
  utilisateursAutorises String?
  // --- Cycle de vie (Actif/En maintenance/Hors service/Consigné/Réformé...) ---
  etat String @default("ACTIF")
  motifEtat String?
  dateEtat DateTime?
  responsableEtatId String?
  risqueAssocieEtat String?
  mesureMaitriseEtat String?
  dateRemiseEnServicePrevue DateTime?
  justificatifEtat String?
  // --- Criticité configurable (sécurité/qualité/environnement/production) ---
  criticiteSecurite Int?
  criticiteQualite Int?
  criticiteEnvironnement Int?
  criticiteProduction Int?
  criticiteScore Int?
  criticiteNiveau String?
  // --- QR code (accès rapide terrain : identification, inspection,
  // déclaration panne/anomalie, historique récent) ---
  qrToken String? @unique
  // --- Cycle de vie du champ (jamais de suppression définitive, cf. exigence
  // "préférer l'archivage/réforme à la suppression") ---
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categoryEq EquipmentCategory? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  fournisseur Fournisseur? @relation(fields:[fournisseurId], references:[id], onDelete:SetNull)
  responsable User? @relation("EquipmentResponsable", fields:[responsableId], references:[id], onDelete:SetNull)
  risks Risk[]
  nonConformities NonConformity[]
  actions Action[]
  safetyEvents SafetyEvent[]
  maintenancePlans EquipmentMaintenancePlan[]
  maintenanceRecords EquipmentMaintenanceRecord[]
  controls EquipmentControl[]
  calibrations EquipmentCalibration[]
  inspections EquipmentInspection[]
  consignations EquipmentConsignation[]
}

// === MODULE ÉQUIPEMENTS — Phase 2 : maintenance préventive/corrective,
// contrôles réglementaires, étalonnage, inspections, consignation (additif,
// aucun champ existant modifié ou supprimé) ===

// Plan de maintenance préventive — la périodicité n'est jamais universelle
// ni codée en dur (cf. exigence "ne pas coder de fausses obligations
// réglementaires universelles") : type de fréquence et valeur sont saisis
// par l'utilisateur pour chaque équipement.
model EquipmentMaintenancePlan {
  id String @id @default(cuid())
  equipmentId String
  designation String
  frequenceType String @default("CALENDAIRE")
  frequenceValeur Int
  uniteFrequence String?
  dateDerniere DateTime?
  dateProchaine DateTime?
  responsableId String?
  prestataire String?
  actif Boolean @default(true)
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  equipment Equipment @relation(fields:[equipmentId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
  records EquipmentMaintenanceRecord[]
}

// Une ligne par intervention, préventive (rattachée à un plan) ou corrective
// (panne) — jamais mélangées dans un simple statut, pour permettre le calcul
// MTBF/MTTR/disponibilité sans ambiguïté.
model EquipmentMaintenanceRecord {
  id String @id @default(cuid())
  equipmentId String
  planId String?
  type String @default("CORRECTIVE")
  statut String @default("PLANIFIEE")
  datePanne DateTime?
  dateDebut DateTime?
  dateFin DateTime?
  dureeHeures Float?
  responsableId String?
  prestataire String?
  description String?
  causePanne String?
  piecesRemplacees String?
  cout Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  equipment Equipment @relation(fields:[equipmentId], references:[id], onDelete:Cascade)
  plan EquipmentMaintenancePlan? @relation(fields:[planId], references:[id], onDelete:SetNull)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
}

// Contrôle réglementaire (levage, incendie, électrique, pression...) — la
// nature exacte et la périodicité restent du texte libre configurable par
// équipement/secteur, jamais une liste figée.
model EquipmentControl {
  id String @id @default(cuid())
  equipmentId String
  designation String
  organisme String?
  referenceReglementaire String?
  dateControle DateTime @default(now())
  dateProchainControle DateTime?
  statut String @default("CONFORME")
  observations String?
  controleurId String?
  cout Float?
  nonConformityId String?
  createdAt DateTime @default(now())
  equipment Equipment @relation(fields:[equipmentId], references:[id], onDelete:Cascade)
  controleur User? @relation(fields:[controleurId], references:[id], onDelete:SetNull)
  nonConformity NonConformity? @relation(fields:[nonConformityId], references:[id], onDelete:SetNull)
}

// Étalonnage des instruments de mesure — un résultat non conforme ou expiré
// déclenche le flag "Ne pas utiliser", jamais une suppression ou un silence.
model EquipmentCalibration {
  id String @id @default(cuid())
  equipmentId String
  dateEtalonnage DateTime @default(now())
  dateProchaineEtalonnage DateTime?
  organismeEtalonneur String?
  certificatNumero String?
  resultat String @default("CONFORME")
  incertitude String?
  nePasUtiliser Boolean @default(false)
  nonConformityId String?
  cout Float?
  createdAt DateTime @default(now())
  equipment Equipment @relation(fields:[equipmentId], references:[id], onDelete:Cascade)
  nonConformity NonConformity? @relation(fields:[nonConformityId], references:[id], onDelete:SetNull)
}

// Vérification avant utilisation / inspection périodique — checklist libre
// en JSON (label/statut/commentaire par point) pour rester adaptable à tout
// type d'équipement sans modèle de données figé par secteur.
model EquipmentInspection {
  id String @id @default(cuid())
  equipmentId String
  type String @default("PRE_USE")
  date DateTime @default(now())
  inspecteurId String?
  statutGlobal String @default("CONFORME")
  items Json?
  commentaire String?
  signature String?
  localisation String?
  createdAt DateTime @default(now())
  equipment Equipment @relation(fields:[equipmentId], references:[id], onDelete:Cascade)
  inspecteur User? @relation(fields:[inspecteurId], references:[id], onDelete:SetNull)
}

// Consignation / cadenassage (LOTO) — tant qu'elle est en cours, l'équipement
// bascule à l'état CONSIGNE ; la levée restaure l'état et trace la date réelle.
model EquipmentConsignation {
  id String @id @default(cuid())
  equipmentId String
  dateDebut DateTime @default(now())
  dateFinPrevue DateTime?
  dateFinReelle DateTime?
  motif String
  responsableId String?
  risqueAssocie String?
  mesureControle String?
  statut String @default("EN_COURS")
  createdAt DateTime @default(now())
  equipment Equipment @relation(fields:[equipmentId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
}

model SafetyTalk {
  id String @id @default(cuid())
  weekStart DateTime
  weekEnd DateTime
  title String
  summary String
  status SafetyTalkStatus @default(DRAFT)
  generatedAt DateTime @default(now())
  approvedAt DateTime?
  createdById String?
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  // --- Fiche complète du quart d'heure sécurité (additif) ---
  theme String?
  objectif String?
  contexte String?
  risquesConcernes String?
  personnesExposees String?
  messagePrincipal String?
  pointsEssentiels String?
  bonnesPratiques String?
  mauvaisesPratiques String?
  questions String?
  exemplesTerrain String?
  mesuresPrevention String?
  conduiteATenir String?
  conclusion String?
  engagementAttendu String?
  quiz Json?
  priorite String?
  siteId String?
  service String?
  zone String?
  equipe String?
  workUnitId String?
  responsableAnimationId String?
  scheduledAt DateTime?
  duree Int?
  frequence String?
  origineType String @default("MANUEL")
  origineRaison String?
  origineModules String?
  realisedAt DateTime?
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  workUnit WorkUnit? @relation(fields:[workUnitId], references:[id], onDelete:SetNull)
  responsableAnimation User? @relation("SafetyTalkAnimateur", fields:[responsableAnimationId], references:[id], onDelete:SetNull)
  recommendations SafetyTalkRecommendation[]
  participants SafetyTalkParticipant[]
  feedbacks SafetyTalkFeedback[]
  quizResults SafetyTalkQuizResult[]
  @@unique([weekStart])
}

// Moteur de recommandation — une proposition de thème générée par l'analyse
// automatique des autres modules, JAMAIS transformée en séance réelle sans
// validation humaine explicite (accepter/modifier/reporter/ignorer).
model SafetyTalkRecommendation {
  id String @id @default(cuid())
  theme String
  motif String
  priorite String
  sourceModules String
  score Int @default(0)
  status String @default("PROPOSEE")
  metadata Json?
  createdAt DateTime @default(now())
  safetyTalkId String?
  safetyTalk SafetyTalk? @relation(fields:[safetyTalkId], references:[id], onDelete:SetNull)
  @@index([status])
}

// Émargement — présence réelle par collaborateur, jamais un simple compteur.
model SafetyTalkParticipant {
  id String @id @default(cuid())
  safetyTalkId String
  employeeId String?
  userId String?
  present Boolean @default(true)
  motifAbsence String?
  signature String?
  createdAt DateTime @default(now())
  safetyTalk SafetyTalk @relation(fields:[safetyTalkId], references:[id], onDelete:Cascade)
  employee Employee? @relation(fields:[employeeId], references:[id], onDelete:SetNull)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([safetyTalkId])
}

// Remontée terrain recueillie pendant la séance — peut devenir une situation
// dangereuse, une NC ou une action CAPA (jamais automatiquement, toujours sur
// décision explicite via transformFeedback).
model SafetyTalkFeedback {
  id String @id @default(cuid())
  safetyTalkId String
  type String
  description String
  localisation String?
  criticite String?
  reportedById String?
  photoUrl String?
  commentaire String?
  mesureImmediate String?
  status String @default("NOUVEAU")
  transformedIntoModule String?
  transformedIntoId String?
  createdAt DateTime @default(now())
  safetyTalk SafetyTalk @relation(fields:[safetyTalkId], references:[id], onDelete:Cascade)
  reportedBy User? @relation(fields:[reportedById], references:[id], onDelete:SetNull)
  @@index([safetyTalkId])
}

model SafetyTalkQuizResult {
  id String @id @default(cuid())
  safetyTalkId String
  participantId String?
  score Int
  total Int
  createdAt DateTime @default(now())
  safetyTalk SafetyTalk @relation(fields:[safetyTalkId], references:[id], onDelete:Cascade)
}

// Seuils de déclenchement configurables par l'administrateur (section "moteur
// de déclenchement automatique" du cahier des charges) — le moteur applique
// une valeur par défaut raisonnable en code si aucune ligne n'existe pour un
// code donné, jamais une exception bloquante.
model SafetyTalkRule {
  id String @id @default(cuid())
  code String @unique
  label String
  active Boolean @default(true)
  seuil Int?
  periodeJours Int?
  createdAt DateTime @default(now())
}

// ============================================================================
// Modules ajoutés pour compléter la parité avec la maquette Gestion QHSE 360
// (Qualité : processus/indicateurs, Réclamations, Fournisseurs, Hygiène,
// Veille réglementaire, Objectifs QHSE). Purement additif : aucun modèle
// existant ci-dessus n'est modifié.
// ============================================================================
model Processus {
  id String @id @default(cuid())
  code String @unique
  nom String
  // Classification — jamais une liste figée, l'utilisateur reste libre
  // de qualifier son processus comme il l'entend.
  type String @default("OPERATIONNEL")
  domaine String?
  departement String?
  siteId String?
  version String?
  statut String @default("ACTIF")
  criticite String?
  // Pilotage
  piloteId String?
  suppleantId String?
  // Finalité et périmètre
  finalite String?
  objectifPrincipal String?
  perimetreDebut String?
  perimetreFin String?
  // SIPOC simple — Suppliers/Inputs/Outputs/Customers en listes ; le "P"
  // (activités) est une vraie structure, voir ProcessusActivity.
  suppliers Json?
  inputs Json?
  outputs Json?
  customers Json?
  // Position sur la cartographie interactive — mémorisée après chaque
  // déplacement, pour que la carte reste telle que l'utilisateur l'a
  // organisée d'une session à l'autre.
  positionX Float?
  positionY Float?
  // Champs historiques conservés tels quels — aucune donnée existante
  // n'est perdue par cet enrichissement.
  proprietaire String?
  objectifs String?
  kpi String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site Site? @relation(fields:[siteId], references:[id], onDelete:SetNull)
  pilote User? @relation("ProcessusPilote", fields:[piloteId], references:[id], onDelete:SetNull)
  suppleant User? @relation("ProcessusSuppleant", fields:[suppleantId], references:[id], onDelete:SetNull)
  activities ProcessusActivity[]
  exigences ProcessusExigence[]
  risks Risk[]
  actions Action[]
  nonConformities NonConformity[]
  audits QhseAudit[]
  documents Document[]
  trainings Training[]
  objectifsQhse ObjectifQhse[]
  qualityControls QualityControl[]
  linksFrom ProcessusLink[] @relation("ProcessusLinkSource")
  linksTo ProcessusLink[] @relation("ProcessusLinkTarget")
  indicateursQualite IndicateurQualite[]
  reclamations Reclamation[]
  safetyEvents SafetyEvent[]
  risquesSanitaires RisqueSanitaire[]
  analysesErgonomiques AnalyseErgonomique[]
  environnementRecords EnvironmentRecord[]
  environnementAspects EnvironnementAspect[]
  auditPrograms AuditProgram[]
}

// Liens dessinés entre processus sur la cartographie interactive — un
// simple trait avec une légende optionnelle (ex. "alimente", "dépend de").
model ProcessusLink {
  id String @id @default(cuid())
  sourceId String
  targetId String
  label String?
  createdAt DateTime @default(now())
  source Processus @relation("ProcessusLinkSource", fields:[sourceId], references:[id], onDelete:Cascade)
  target Processus @relation("ProcessusLinkTarget", fields:[targetId], references:[id], onDelete:Cascade)
  @@unique([sourceId,targetId])
}

// Le "P" du SIPOC — chaque étape du processus, avec sa propre matrice
// RACI. Ordre libre, ajout illimité, comme demandé.
model ProcessusActivity {
  id String @id @default(cuid())
  processusId String
  code String?
  order Int @default(0)
  name String
  description String?
  responsibleId String?
  inputs String?
  outputs String?
  resources String?
  equipment String?
  frequency String?
  criticality String?
  createdAt DateTime @default(now())
  processus Processus @relation(fields:[processusId], references:[id], onDelete:Cascade)
  responsible User? @relation("ProcessusActivityResponsible", fields:[responsibleId], references:[id], onDelete:SetNull)
  racis ProcessusRaci[]
}

// Matrice RACI par activité. roleLabel permet de désigner un service ou
// une fonction sans forcer un compte utilisateur du système.
model ProcessusRaci {
  id String @id @default(cuid())
  activityId String
  userId String?
  roleLabel String?
  raci String
  activity ProcessusActivity @relation(fields:[activityId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
}

// Exigences légales, réglementaires ou normatives rattachées au
// processus — configurable pour n'importe quel référentiel (ISO 9001,
// 14001, 45001, 22000, HACCP, exigences client, internes...), jamais
// limité à une seule norme en dur.
model ProcessusExigence {
  id String @id @default(cuid())
  processusId String
  exigence String
  origine String?
  reference String?
  applicable Boolean @default(true)
  preuveConformite String?
  responsableId String?
  frequenceVerification String?
  derniereVerification DateTime?
  prochaineEcheance DateTime?
  statutConformite String @default("CONFORME")
  createdAt DateTime @default(now())
  processus Processus @relation(fields:[processusId], references:[id], onDelete:Cascade)
  responsable User? @relation(fields:[responsableId], references:[id], onDelete:SetNull)
}

model IndicateurQualite {
  id String @id @default(cuid())
  code String @unique
  indicateur String
  actuel Float
  cible Float
  unite String?
  sensInverse Boolean @default(false)
  // Domaine — permet de réutiliser exactement le même moteur de KPI
  // configurable pour la Qualité, l'Environnement, ou tout futur
  // module, sans dupliquer la structure.
  domaine String @default("QUALITE")
  // Catégorie et formule — texte libre transparent, jamais un calcul
  // caché : l'utilisateur voit toujours comment la valeur est obtenue.
  categorie String?
  formule String?
  frequence String?
  processusId String?
  seuilVert Float?
  seuilOrange Float?
  poids Float @default(1)
  // MANUEL = saisi par l'utilisateur, AUTO = calculé depuis un autre
  // module (voir /business/indicateurs-auto) — jamais les deux à la
  // fois pour éviter la double saisie que le prompt veut éliminer.
  source String @default("MANUEL")
  autoKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  processus Processus? @relation(fields:[processusId], references:[id], onDelete:SetNull)
  mesures IndicateurMesure[]
}

// Historique des mesures — sans lui, un indicateur n'a ni tendance ni
// évolution, seulement une valeur figée dans le temps.
model IndicateurMesure {
  id String @id @default(cuid())
  indicateurId String
  valeur Float
  periode DateTime @default(now())
  commentaire String?
  createdAt DateTime @default(now())
  indicateur IndicateurQualite @relation(fields:[indicateurId], references:[id], onDelete:Cascade)
}

// Pondération de chaque indicateur de la bibliothèque automatique dans
// l'indice global de performance qualité — entièrement configurable,
// jamais figée en dur dans le code.
model IndicateurPonderation {
  id String @id @default(cuid())
  autoKey String @unique
  poids Float @default(1)
  updatedAt DateTime @updatedAt
}

model Reclamation {
  id String @id @default(cuid())
  code String @unique
  client String
  typeClient String?
  clientContact String?
  motif String
  description String?
  canal String?
  date DateTime @default(now())
  dateEvenement DateTime?
  // Produit / service concerné
  produitService String?
  reference String?
  lotNumber String?
  commandeNumber String?
  factureNumber String?
  quantiteConcernee Float?
  siteId String?
  processusId String?
  fournisseurId String?
  // Classification — texte libre configurable, jamais une liste figée
  categorieProbleme String?
  gravite String @default("Faible")
  scoreCriticite Int?
  statut String @default("OPEN")
  // SLA — sans ces dates, aucun délai n'est mesurable
  dateAccuseReception DateTime?
  datePremiereReponse DateTime?
  dateResolutionPrevue DateTime?
  dateResolutionReelle DateTime?
  dateCloture DateTime?
  delaiCibleJours Int?
  // Action curative immédiate (section 5 du prompt)
  actionCurative String?
  actionCurativeResponsableId String?
  actionCurativeDate DateTime?
  actionCurativeCout Float?
  // Analyse des causes — 5 Pourquoi + Ishikawa (5M)
  methodeAnalyse String?
  pourquoi1 String?
  pourquoi2 String?
  pourquoi3 String?
  pourquoi4 String?
  pourquoi5 String?
